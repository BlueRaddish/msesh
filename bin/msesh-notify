#!/usr/bin/env bash
# msesh-notify — desktop toast for msesh sessions.
#
# Four modes:
#   msesh-notify --turn-end       a specific pane has finished its turn; the
#                                 agent itself says so, via a Stop hook
#   msesh-notify --session-start  record which conversation is in this pane,
#                                 from a SessionStart hook's stdin
#   msesh-notify                  scan tmux for msesh windows that have gone
#                                 quiet or rung the bell, and toast those
#   msesh-notify "Title" "Body"   pop a toast right now
#
# The first two are both called by Claude Code, from its own hooks, which is
# why they live together here rather than in msesh: this file has no re-exec
# and no argument parsing to go wrong, and it is already the program the
# user's settings.json points at.
#
# --turn-end is the good signal and the scan is the fallback. An agent that
# tells you it has finished is exact and immediate; silence is a guess that is
# both late (by the whole timeout) and wrong in either direction — an agent
# thinking quietly looks finished, and one printing steadily never alerts. The
# scan still earns its place for panes that are not agents: a build, a test run,
# a REPL, none of which will ever call a hook.
#
# tmux only raises window alerts for windows you are not currently looking at,
# which is the behaviour you want: no toast for the pane already on screen.
# --turn-end keeps that rule deliberately, by checking the pane's window is not
# the current one before it says anything.
#
# Called by tmux via run-shell and by Claude Code via its Stop hook, so it must
# stay quiet and must never fail in a way that reaches the agent's output.

set -uo pipefail

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=msesh-platform
. "$SELF_DIR/msesh-platform"

TMUX_BIN=$(plat_tmux)

# --- the toast itself --------------------------------------------------------
# Which notifier, and how it is spoken to, is the platform layer's problem —
# and it always succeeds, falling back to a tmux message on a machine with no
# desktop notifier at all. Backgrounded because some notifiers block for the
# lifetime of the notification and nothing here is worth waiting on.
toast() { plat_notify "$1" "${2:-}" & }

# --- session-start mode --------------------------------------------------------
# Claude Code hands a SessionStart hook a JSON object on stdin carrying the
# conversation's session_id, its cwd, and the path to its transcript. Recording
# which pane that conversation is in is the whole basis of 'restore --resume':
# without it a restored pane is a fresh agent with no memory of the work.
#
# Read with sed rather than a JSON parser on purpose. This runs on every session
# start, in the agent's own process tree, on machines that may have no python at
# all — and the two fields wanted are a UUID and a path, written by a program,
# never by hand. 'msesh hooks' still uses python, because editing someone's
# settings.json is a different risk from reading one generated line.
#
# The id survives --resume unchanged (verified), so a recorded id stays valid
# for the life of the conversation; the pane id does not, which is why this is
# an upsert keyed by pane rather than an append.
if [ "${1:-}" = "--session-start" ]; then
  pane=${TMUX_PANE:-}
  payload=$(cat 2>/dev/null)
  [ -n "$pane" ] || exit 0                     # not in tmux; nothing to key on

  sid=$(printf '%s' "$payload" |
        sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  [ -n "$sid" ] || exit 0

  cwd=$(printf '%s' "$payload" |
        sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  transcript=$(printf '%s' "$payload" |
        sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)

  state=${MSESH_STATE:-$(plat_config_home)/sessions}
  mkdir -p "$state" 2>/dev/null || exit 0
  map=$state/agents.map

  # Rewrite through a temp file: two panes can start at the same moment, and a
  # half-written map is worse than a missing one.
  tmp=$map.$$
  {
    printf '# msesh agents.map — pane, conversation id, cwd, transcript\n'
    printf '# written by a SessionStart hook; read by "restore --resume"\n'
    if [ -r "$map" ]; then
      while IFS= read -r line || [ -n "$line" ]; do
        case $line in
          '#'*|'') continue ;;
          "$pane	"*) continue ;;                 # this pane, superseded below
          *) printf '%s\n' "$line" ;;
        esac
      done < "$map"
    fi
    printf '%s\t%s\t%s\t%s\n' "$pane" "$sid" "$cwd" "$transcript"
  } > "$tmp" 2>/dev/null && mv "$tmp" "$map" 2>/dev/null
  rm -f "$tmp" 2>/dev/null
  exit 0
fi

# --- turn-end mode ------------------------------------------------------------
# Called from the agent's own Stop hook, inside the pane that finished. Every
# failure here is silent and successful: this runs in the agent's process tree,
# and a notifier that prints an error into someone's session is worse than one
# that quietly does nothing.
# --agent-notify: an agent that reports through one command rather than a hook
# per event. codex is the case that exists: its `notify` config names a program
# and hands it one JSON argument. Established by capture, not documentation —
# the published config reference names the key and not a single event.
#
#   {"type":"agent-turn-complete","thread-id":"…","turn-id":"…","cwd":"…",
#    "client":"codex_exec","input-messages":[…],"last-assistant-message":"…"}
#
# agent-turn-complete is the only type the shipped binary can emit: there is no
# agent-needs-approval or equivalent anywhere in it. So codex can say it has
# finished and never that it is blocked on you, and this maps the one signal
# that exists onto @turn=waiting. If a later codex grows an approval event,
# add it here and map it to input — the states already exist.
if [ "${1:-}" = "--agent-notify" ]; then
  payload=${2:-}
  [ -n "$payload" ] || payload=$(cat 2>/dev/null || true)
  [ -n "$payload" ] || exit 0

  case $payload in
    *'"type":"agent-turn-complete"'*|*'"type": "agent-turn-complete"'*) ;;
    *) exit 0 ;;                      # a type msesh has no meaning for
  esac

  # The pane comes from the environment, the way it does for every hook: the
  # agent runs in the pane, so its children inherit TMUX_PANE. A Windows agent
  # launched from a WSL pane needs WSLENV to carry it across, which is why
  # msesh sets that when it starts one.
  pane=${3:-${TMUX_PANE:-}}
  [ -n "$pane" ] || exit 0
  [ -x "$TMUX_BIN" ] || command -v "$TMUX_BIN" >/dev/null 2>&1 || exit 0

  info=$("$TMUX_BIN" display-message -t "$pane" -p \
    '#{session_name}|#{window_index}|#{@label}|#{@msesh}' 2>/dev/null) || exit 0
  IFS='|' read -r sess widx label stamp <<< "$info"
  [ "$stamp" = 1 ] || exit 0

  "$TMUX_BIN" set-option -p -t "$pane" @turn waiting 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$sess:$widx" monitor-activity on 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$sess:$widx" @alert 1 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$sess:$widx" @msesh_notified 1 2>/dev/null
  "$TMUX_BIN" refresh-client -S 2>/dev/null

  toast "msesh: ${label:-a pane} finished — $sess" \
        "Window $widx is waiting on you."
  exit 0
fi

# --resumed: you answered. The only reliable evidence that a mark has been
# dealt with, because the terminal never tells tmux where you are looking —
# so the mark is cleared by the thing you did, not by where you might be.
# Clears this pane, and the window's alert with it once no pane still wants
# anything, so switching windows is no longer the only thing that calms a
# session down.
if [ "${1:-}" = "--resumed" ] || [ "${1:-}" = "--seen" ]; then
  pane=${2:-${TMUX_PANE:-}}
  [ -n "$pane" ] || exit 0
  [ -x "$TMUX_BIN" ] || command -v "$TMUX_BIN" >/dev/null 2>&1 || exit 0

  info=$("$TMUX_BIN" display-message -t "$pane" -p '#{session_name}|#{window_index}|#{@msesh}' \
    2>/dev/null) || exit 0
  IFS='|' read -r sess widx stamp <<< "$info"
  [ "$stamp" = 1 ] || exit 0

  "$TMUX_BIN" set-option -p -t "$pane" -u @turn 2>/dev/null

  still=$("$TMUX_BIN" list-panes -t "$sess:$widx" -F '#{@turn}' 2>/dev/null | grep -c .)
  if [ "${still:-0}" -eq 0 ]; then
    "$TMUX_BIN" set-window-option -t "$sess:$widx" @alert "" 2>/dev/null
    "$TMUX_BIN" set-window-option -t "$sess:$widx" @msesh_notified "" 2>/dev/null
    "$TMUX_BIN" set-window-option -u -t "$sess:$widx" pane-border-style 2>/dev/null
    "$TMUX_BIN" set-window-option -u -t "$sess:$widx" pane-active-border-style 2>/dev/null
    # Off again with the mark: activity monitoring restarts the silence
    # countdown on every byte, so a chatty window would never go quiet enough
    # to dim. It is only wanted while there is a mark that needs clearing.
    "$TMUX_BIN" set-window-option -t "$sess:$widx" monitor-activity off 2>/dev/null
  fi
  "$TMUX_BIN" refresh-client -S 2>/dev/null
  exit 0
fi

# --needs-input: the agent is blocked ON YOU — a permission prompt, an idle
# prompt, an MCP elicitation. This is the one alert that is always worth making,
# and the only one that fires while a turn is still running: a permission
# request arrives mid-turn, so the turn-end hook never sees it. Being "attached
# with the window active" is not evidence you are looking, either — the session
# is a Terminal tab, and tmux cannot tell a foreground tab from a background
# one, so suppressing on that would silence exactly the case this exists for.
if [ "${1:-}" = "--needs-input" ]; then
  pane=${2:-${TMUX_PANE:-}}
  [ -n "$pane" ] || exit 0
  [ -x "$TMUX_BIN" ] || command -v "$TMUX_BIN" >/dev/null 2>&1 || exit 0

  # The hook fires for every notification the agent raises, including ones that
  # want nothing from you (auth succeeded, agent finished). Read the payload and
  # keep only the kinds that mean "blocked, waiting on a human". Unparseable or
  # absent input is treated as interesting: a missed prompt is worse than an
  # extra toast, and a payload we do not understand is not evidence of calm.
  payload=$(cat 2>/dev/null || true)
  case $payload in
    *permission_prompt*|*idle_prompt*|*agent_needs_input*|*elicitation_dialog*|'') ;;
    *) exit 0 ;;
  esac

  info=$("$TMUX_BIN" display-message -t "$pane" -p \
    '#{session_name}|#{window_index}|#{@label}|#{@msesh}' 2>/dev/null) || exit 0
  IFS='|' read -r sess widx label stamp <<< "$info"
  [ "$stamp" = 1 ] || exit 0

  "$TMUX_BIN" set-option -p -t "$pane" @turn input 2>/dev/null
  # Watch for output while the mark is up. Selecting a pane clears it, but a
  # pane you are *already* in is never selected again, so that mark had no way
  # to go. Anything the pane prints from here — including the echo of what you
  # type into it — is evidence you are dealing with it, and fires the scan that
  # clears it. Switched off again the moment it clears, because activity
  # monitoring restarts the silence countdown and the two do not compose.
  "$TMUX_BIN" set-window-option -t "$sess:$widx" monitor-activity on 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$sess:$widx" @alert 1 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$sess:$widx" @msesh_notified 1 2>/dev/null
  "$TMUX_BIN" refresh-client -S 2>/dev/null

  toast "msesh: ${label:-a pane} needs you — $sess" \
        "Window $widx is blocked waiting for your input."
  exit 0
fi

if [ "${1:-}" = "--turn-end" ]; then
  pane=${2:-${TMUX_PANE:-}}
  [ -n "$pane" ] || exit 0                     # not in tmux; nothing to mark
  [ -x "$TMUX_BIN" ] || command -v "$TMUX_BIN" >/dev/null 2>&1 || exit 0

  info=$("$TMUX_BIN" display-message -t "$pane" -p \
    '#{session_name}|#{window_index}|#{@label}|#{@msesh}|#{window_active}|#{session_attached}' \
    2>/dev/null) || exit 0
  IFS='|' read -r sess widx label stamp wactive sattached <<< "$info"
  [ "$stamp" = 1 ] || exit 0                   # not a session msesh built

  # The pane records that it is waiting, whether or not anything is said out
  # loud — 'msesh status' reads this, and it is the only per-pane record of
  # "finished a turn" that exists.
  "$TMUX_BIN" set-option -p -t "$pane" @turn waiting 2>/dev/null

  # This used to exit here when the window was active and the session
  # attached, on the theory that you were looking at it. The theory does not
  # survive contact with a Terminal tab: tmux is told nothing about focus —
  # not when a tab is switched, not even when another application takes the
  # foreground; both were tested and no client-focus-in or -out ever arrived.
  # "Attached with the active window" therefore means "the tab exists", which
  # is not the same claim at all, and suppressing on it silenced the alert
  # precisely when you were looking somewhere else.
  #
  # So it always reports. What makes the mark go away is answering — the
  # --resumed path, driven by the agent's own "the human said something" event
  # — rather than a guess about where your eyes are.

  # Mark the window the way the silence path would, so the two agree about what
  # a waiting window looks like. Activity monitoring goes on with it, so that a
  # mark on the pane you are already sitting in still has a way to clear — see
  # the --needs-input path for why selecting cannot do it.
  "$TMUX_BIN" set-window-option -t "$sess:$widx" monitor-activity on 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$sess:$widx" @alert 1 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$sess:$widx" pane-border-style "fg=colour196,bold" 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$sess:$widx" pane-active-border-style "fg=colour196,bold" 2>/dev/null
  # Suppress the silence scan's toast for this alert: the turn-end message is
  # better in every way and arrives first, so the timer's version is noise.
  "$TMUX_BIN" set-window-option -t "$sess:$widx" @msesh_notified 1 2>/dev/null
  "$TMUX_BIN" refresh-client -S 2>/dev/null

  prefix=$("$TMUX_BIN" show-options -gv prefix 2>/dev/null || echo prefix)
  toast "msesh: ${label:-a pane} finished — $sess" \
        "Window $widx is waiting on you. Go to the '$sess' tab, then press ${prefix:-prefix} $widx."
  exit 0
fi

if [ $# -ge 1 ]; then
  toast "$1" "${2:-}"
  exit 0
fi

# --- scan mode ---------------------------------------------------------------
# Only sessions msesh built are considered: it stamps @msesh on each of them.
# Formats are safe here — this always runs on the same side as the tmux it is
# talking to, so nothing rewrites the argv on the way across.
#
# A read loop rather than mapfile: mapfile is bash 4, and macOS ships 3.2.
rows=()
while IFS= read -r _row || [ -n "$_row" ]; do
  [ -n "$_row" ] && rows+=("$_row")
done < <(
  "$TMUX_BIN" list-windows -a \
    -F '#{session_name}|#{window_index}|#{window_name}|#{window_silence_flag}#{window_activity_flag}#{window_bell_flag}|#{@msesh}|#{@msesh_notified}|#{@alert}' \
    2>/dev/null
)

# --- highlighting -------------------------------------------------------------
# A toast is gone in seconds and says nothing about where to look; with several
# sessions across several tabs, "something finished" is not an answer. So the
# alerting window is marked in tmux for as long as the alert lasts.
#
# tmux has no per-pane silence flag — alerts are raised on the window, and a
# window is silent only when every pane in it is — so the window is the honest
# unit to highlight, and all of its borders light up together. Cleared by the
# re-arm branch below, which fires once you have actually looked at it.
#
# @alert is read by the pane-border-format msesh installs; the border styles
# are unset rather than set back, so whatever the session or ~/.tmux.conf says
# takes over again without this having to know what that was.
highlight_on() {
  "$TMUX_BIN" set-window-option -t "$1" @alert 1 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$1" pane-border-style "fg=colour196,bold" 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$1" pane-active-border-style "fg=colour196,bold" 2>/dev/null
}

# Silence is not the same claim as "something wants you", and it should not
# look like one. Nothing has printed for a while; that is worth noting and not
# worth interrupting for, so the window dims instead of going red. Red is
# reserved for a signal that something actually asked.
idle_on() {
  "$TMUX_BIN" set-window-option -t "$1" @idle 1 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$1" pane-border-style "fg=colour240" 2>/dev/null
  "$TMUX_BIN" set-window-option -t "$1" pane-active-border-style "fg=colour244" 2>/dev/null
}

idle_off() {
  "$TMUX_BIN" set-window-option -t "$1" @idle "" 2>/dev/null
  "$TMUX_BIN" set-window-option -u -t "$1" pane-border-style 2>/dev/null
  "$TMUX_BIN" set-window-option -u -t "$1" pane-active-border-style 2>/dev/null
}

highlight_off() {
  "$TMUX_BIN" set-window-option -t "$1" @alert "" 2>/dev/null
  "$TMUX_BIN" set-window-option -u -t "$1" pane-border-style 2>/dev/null
  "$TMUX_BIN" set-window-option -u -t "$1" pane-active-border-style 2>/dev/null
}

# Spelled out rather than assumed to be C-b: the toast tells you which key to
# press, and being told the wrong one is worse than not being told.
PREFIX=$("$TMUX_BIN" show-options -gv prefix 2>/dev/null || echo prefix)
[ -n "$PREFIX" ] || PREFIX=prefix

for row in ${rows[@]+"${rows[@]}"}; do
  IFS='|' read -r sess widx wname flags stamp notified alerted <<< "$row"
  [ "$stamp" = 1 ] || continue

  # Output while a mark is up means the pane is being used — most often the
  # echo of what you are typing into it. That is the answer to "have you dealt
  # with this" for the pane you were already sitting in, which selecting it
  # cannot give because it is never selected again. Treated exactly like
  # having looked at it.
  case $flags in
    ?1?) [ -n "$alerted" ] && flags=000 ;;
  esac

  if [ "$flags" = "000" ]; then
    # Alert cleared (you looked at it) — re-arm so the next one toasts again.
    [ -n "$notified" ] &&
      "$TMUX_BIN" set-window-option -t "$sess:$widx" @msesh_notified "" 2>/dev/null
    [ -n "$alerted" ] && highlight_off "$sess:$widx"
    idle_off "$sess:$widx"
    # Whatever set a pane's @turn, looking at the window answers it. Cleared
    # here rather than in the turn-end path because tmux has a hook for an
    # alert being raised and none for one being cleared — switching windows is
    # what clears an alert, and this function is what runs when you switch.
    while IFS= read -r _p; do
      [ -n "$_p" ] && "$TMUX_BIN" set-option -p -t "$_p" -u @turn 2>/dev/null
    done < <("$TMUX_BIN" list-panes -t "$sess:$widx" -F '#{pane_id}' 2>/dev/null)
    # The watch goes off with the marks it existed to clear, or a busy window
    # would keep resetting the silence countdown and never dim.
    "$TMUX_BIN" set-window-option -t "$sess:$widx" monitor-activity off 2>/dev/null
    continue
  fi

  # Mark it on screen — but as what it is. A silence flag means nothing has
  # printed for a while, which is idleness, not a request: dimming says so
  # without claiming your attention. Only the bell branch, where a program
  # actually asked, keeps the red.
  #
  # Left dim on purpose even when a toast follows: the toast is the interrupt,
  # the colour is just the map back to the window.
  # flags is silence|activity|bell. A bell is a program asking for you and gets
  # the full treatment. Silence is not a request at all — it is the absence of
  # one — so it dims the window and stops there. Never a toast: being
  # interrupted to be told that nothing happened is the definition of noise,
  # and it is what made these alerts worth ignoring.
  case $flags in
    ??1) [ -n "$alerted" ] || highlight_on "$sess:$widx" ;;
    *)   # Dim only when nothing in the window is actually waiting on you.
         # Otherwise the quiet-looking grey would paint over the red that says
         # a pane is blocked — and a window is silent precisely while it waits
         # for an answer, so the two coincide exactly when it matters most.
         [ -n "$alerted" ] || idle_on "$sess:$widx"
         continue ;;
  esac

  [ -n "$notified" ] && continue          # already toasted this alert
  "$TMUX_BIN" set-window-option -t "$sess:$widx" @msesh_notified 1 2>/dev/null

  # Name the panes so you know which one to go to without switching first.
  labels=$("$TMUX_BIN" list-panes -t "$sess:$widx" -F '#{@label}' 2>/dev/null \
           | paste -sd ', ' - 2>/dev/null)
  [ -n "$labels" ] || labels=$wname

  # Session name first, because that is what the Windows Terminal tab is
  # called; window index second, because that is the key you press once you
  # are in it. Both, in that order, are the whole route from a toast to the
  # thing that is waiting.
  toast "msesh: $sess — window $widx is waiting" \
        "$labels — quiet, so probably done. Go to the '$sess' tab, then press $PREFIX $widx. The waiting block has a red border."
done
