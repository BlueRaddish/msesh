#!/usr/bin/env bash
# msesh — multi-session management. Opens a tmux session of N panes in a new
# Windows Terminal tab, where each pane runs a preset: a claude session, a
# shell, or anything you name in the presets file.
#
# What msesh does:
#
#   lazy       --lazy opens agent panes with the command pre-typed but NOT run,
#              so nothing cold-starts until you press Enter in the panes you
#              actually want. Panes start on their own otherwise.
#   persistent sessions outlive the tab. `msesh attach NAME` returns to the live
#              session instead of rebuilding it. `msesh rebuild` forces a fresh
#              build, --ephemeral ties the session's life to the tab again.
#   sized      any pane count, not a fixed 2x2. Panes tile up to 4 per window,
#              then spill into new tmux windows (prefix+n / prefix+p to switch).
#   recoverable every build records a manifest, so `msesh restore work` after a
#              crash or a reboot rebuilds that session exactly as it was.
#              `msesh restore --all` does the lot — point a logon task at it.
#   noisy      a pane that goes quiet is a pane waiting on you, so msesh pops a
#              Windows toast when one does. Works for claude and for anything
#              else in a pane. --notify tunes the threshold, --no-notify is off.
#
# The command surface is verb-first: `msesh <command> [options] [specs]`, one
# verb per thing msesh can do, with the handful of options that genuinely vary
# per build left as flags. Every verb is dispatched in one place — see the
# "commands" section below — and `msesh help TOPIC` carries the long-form
# manual so the default help stays inside a screen.
#
# The user-facing manual — usage, every option, examples, file locations — is
# the help_* functions further down, not this comment. `msesh help` prints it.
# This header is for whoever is editing the file.
#
# A restored session takes its settings from its manifest unless you overrode
# them on this command line, so the option loop records what it saw in the
# *_SET flags and manifest_load reads those. Add a flag that writes to one of
# the manifested settings and it needs to set the matching *_SET, or passing it
# will look like you said nothing and the manifest will win.
#
# Platforms: Linux, macOS, Windows (MSYS2) and WSL. Everything that differs
# between them — finding tmux, opening a terminal, raising a notification,
# translating a path — lives in msesh-platform beside this file, and NOTHING
# in here may name an operating system or a platform binary. test.sh enforces
# that with a grep. On Windows, PowerShell and cmd reach msesh through
# msesh.cmd, and any other bash is handed over to MSYS2 by the platform layer,
# because MSYS2 is the only place tmux exists there.
#
# Env overrides: CLAUDE_BIN, CLAUDE_FLAGS, TMUX_BIN, CLAUDE_JSON,
#                MSESH_PRESETS, MSESH_AGENTS, MSESH_DEFAULT_PRESET,
#                MSESH_STATE, MSESH_LAYOUTS, MSESH_NOTIFY_CMD, MSESH_TERMINAL,
#                MSESH_OS, MSESH_MSYS_ROOT, WT_BIN, WT_PROFILE

set -euo pipefail

# --- the machine we are on ----------------------------------------------------
# Everything platform-specific lives in msesh-platform, next to this file, and
# nothing below this point may name an OS or a platform binary — test.sh checks.
# Resolved before anything else because the bootstrap below may re-exec us.
SELF_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=msesh-platform
. "$SELF_DIR/msesh-platform"

# Some machines need a different runtime to reach tmux at all; on the rest this
# returns immediately. It may not return: on Windows it re-execs into MSYS2.
plat_bootstrap "$0" ${@+"$@"}

# The far end of that handover, where arguments come back off disk before
# anything has had a chance to look at "$@". A no-op everywhere else.
if _argv_in=$(plat_bootstrap_argv); then
  _argv_arr=()
  while IFS= read -r _a || [ -n "$_a" ]; do _argv_arr+=("$_a"); done <<EOF
$_argv_in
EOF
  set -- ${_argv_arr[@]+"${_argv_arr[@]}"}
  unset _argv_arr _argv_in
fi


SESSION=msesh
WORKDIR=$PWD
EFFORTS_RAW=
WINDOW_NAMES=
EAGER=1
PANES_PER_WINDOW=4
NOTIFY_SILENCE=20
ADD=0
FRESH=0
EPHEMERAL=0
# How long a session survives with nobody attached, in seconds. 30 minutes:
# long enough that closing a tab by mistake costs nothing, short enough that a
# week of closed tabs is not still holding agents. 0 disables reaping.
REAP_AFTER=${MSESH_REAP_AFTER:-1800}
OPEN_TAB=1
PRESEED_TRUST=1
DRY_RUN=0
SEND_ENTER=1
SEND_ALL=0
SEND_TARGET=            # pane index, or 'all'
SEND_TARGET_MAYBE=      # a word that is a target only if it names a pane
ACTION=
RESTORE=0
RESUME=0
ALL=0
FORGET=
ATTACH_ONLY=0
PRESET_SUB=
LAYOUT_SUB=
HOOKS_SUB=

# Set by the option loop when the corresponding flag actually appears on the
# command line. manifest_load consults these to decide what you overrode: it
# used to compare each value against its default literal instead, which quietly
# stopped working whenever a flag was passed the same value as the default
# (`-x` once the default became eager, `-w 4` once the default became 4).
DIR_SET=0
EAGER_SET=0
WIDTH_SET=0
NOTIFY_SET=0
WINDOWS_SET=0
# Not manifested, but the same idea: a layout names the session it builds
# unless you said otherwise.
SESSION_SET=0

# A plain shell, deliberately. This used to default to `claude`, which meant the
# shortest command in the tool started four agents with permission prompts
# turned off — expensive, surprising, and increasingly wrong as msesh stops
# being a Claude-only launcher. Ask for agents by name: `msesh build 4 claude`.
# MSESH_DEFAULT_PRESET=claude restores the old behaviour for anyone who wants it.
DEFAULT_PRESET=${MSESH_DEFAULT_PRESET:-shell}

MSESH_VERSION=1.9.0

# The manifest and layout file format, which moves independently of the tool's
# own version and only when the meaning of a key changes. Written into every
# file msesh saves and checked on the way back in: the first time this changes,
# the difference between a migration and a puzzling failure is whether the old
# files said what they were. Files written before 0.6.0 carry no version and
# are read as 1, which is what they are.
MSESH_FORMAT=2

# Claude Code's two files. The first holds the workspace-trust record msesh
# pre-seeds; the second holds hooks, and is where 'msesh hooks' installs the
# turn-end signal. Both are Claude Code's, not msesh's, which is why everything
# that touches them says so in its name.
# CLAUDE_CONFIG_DIR moves both of them, and moves them asymmetrically: the
# settings file goes to D/settings.json — NOT D/.claude/settings.json — while
# the trust record, which normally sits *beside* ~/.claude as ~/.claude.json,
# moves *inside* as D/.claude.json. Established by experiment against claude
# 2.1.221, not from documentation: a malformed D/settings.json is reported by
# 'claude doctor' as invalid, while the same file one level down is ignored.
#
# Getting this wrong is silent in the worst way. On a machine with the variable
# set — a second account, a sandbox, a CI image — msesh would write a settings
# file Claude Code never reads, report success, and have 'hooks status' agree,
# while the turn-end signal simply never arrived.
# codex keeps one config file and reports every event through a single command
# named in it, rather than a hook per event. CODEX_HOME moves it, the same way
# CLAUDE_CONFIG_DIR moves Claude's.
CODEX_DIR=${CODEX_HOME:-$HOME/.codex}
CODEX_CONFIG=${CODEX_CONFIG:-$CODEX_DIR/config.toml}

CLAUDE_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  CLAUDE_SETTINGS=${CLAUDE_SETTINGS:-$CLAUDE_CONFIG_DIR/settings.json}
else
  CLAUDE_SETTINGS=${CLAUDE_SETTINGS:-$HOME/.claude/settings.json}
fi

# --- agents ------------------------------------------------------------------
# Some panes hold an interactive coding agent rather than a shell, and two of
# msesh's behaviours are about that distinction: -e injects a reasoning-effort
# flag, and --lazy pre-types the command instead of running it, because these
# are the panes that are slow and expensive to start.
#
# Neither behaviour is about Claude. This used to be one is_claude_cmd()
# returning true or false, which meant 'agent' and 'claude' were the same idea
# in the code and -e could only ever work for one vendor. The table below is
# the whole of what msesh knows about any particular agent — its name, how it
# spells its effort flag, and which levels it accepts — so teaching msesh about
# another one is a line here, not a change to the logic.
#
# The flag carries its own separator: 'claude --effort high' takes a space,
# 'codex -c model_reasoning_effort=high' takes none. An empty flag means the
# agent has no effort setting, and its panes are then left out of -e entirely
# rather than being an error — a mixed session should not have to explain
# itself. Levels are listed low to high, and a level an agent does not have is
# an error naming both, because silently running at some other effort is worse
# than not starting.
AGENT_NAMES=()
AGENT_EFFORT=()    # flag spelling, including its separator; '' for none
AGENT_LEVELS=()    # accepted levels, low to high; '' for none
AGENT_RESUME=()    # flag that takes a conversation id; '' for none

agent_register() {
  local i
  for i in "${!AGENT_NAMES[@]}"; do
    if [ "${AGENT_NAMES[$i]}" = "$1" ]; then
      AGENT_EFFORT[$i]=$2; AGENT_LEVELS[$i]=$3; AGENT_RESUME[$i]=${4:-}; return
    fi
  done
  AGENT_NAMES+=("$1"); AGENT_EFFORT+=("$2"); AGENT_LEVELS+=("$3")
  AGENT_RESUME+=("${4:-}")
}

agent_register claude "--effort " "low,medium,high,xhigh" "--resume "
agent_register codex  "-c model_reasoning_effort=" "low,medium,high"
agent_register gemini "" ""
agent_register aider  "" ""

# Same 'name = value' shape as presets.conf, with the fields a registration
# needs split on '|', so an agent msesh has never heard of is a line in a file
# rather than a patch to this script:
#
#   myagent = --reasoning | quick,deep | --continue
#   otheragent =                        (no effort setting)
#
# The third field is optional and rarely needed: it is the flag that takes a
# conversation id, and only an agent that can be resumed by id has one. codex
# resumes by recency rather than by id, which is a different thing and not
# something msesh can record, so it is left out rather than faked.
AGENT_FILE=${MSESH_AGENTS:-$(plat_config_home)/agents.conf}
if [ -r "$AGENT_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%$'\r'}
    case $line in ''|'#'*) continue ;; *=*) ;; *) continue ;; esac
    aname=${line%%=*}; arest=${line#*=}
    aflag=${arest%%|*}
    case $arest in *'|'*) alevels=${arest#*|} ;; *) alevels= ;; esac
    case $alevels in *'|'*) aresume=${alevels#*|}; alevels=${alevels%%|*} ;; *) aresume= ;; esac
    aname=$(printf '%s' "$aname" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    alevels=$(printf '%s' "$alevels" | sed 's/[[:space:]]//g')
    # Only the leading space is trimmed from the flags: a trailing one is how
    # '--effort ' and '--resume ' say they want a space before their value.
    aflag=${aflag#"${aflag%%[![:space:]]*}"}
    aresume=${aresume#"${aresume%%[![:space:]]*}"}
    [ -n "$aname" ] && agent_register "$aname" "$aflag" "$alevels" "$aresume"
  done < "$AGENT_FILE"
fi

# The agent a pane command runs, or nothing if it is a shell or a plain
# command. Read from the command itself rather than a marker in the presets
# file, so a user preset like `review = claude ... /code-review` is classified
# correctly for free, and so is `mycodex = codex --full-auto`.
agent_of_cmd() {
  local first=${1%% *} base i
  base=${first##*[/\\]}
  base=${base%.exe}; base=${base%.cmd}; base=${base%.bat}
  for i in "${!AGENT_NAMES[@]}"; do
    if [ "$base" = "${AGENT_NAMES[$i]}" ]; then printf '%s' "$base"; return 0; fi
  done
  return 1
}

agent_field() {                       # agent_field NAME effort|levels|resume
  local i
  for i in "${!AGENT_NAMES[@]}"; do
    [ "${AGENT_NAMES[$i]}" = "$1" ] || continue
    case $2 in
      effort) printf '%s' "${AGENT_EFFORT[$i]}" ;;
      levels) printf '%s' "${AGENT_LEVELS[$i]}" ;;
      resume) printf '%s' "${AGENT_RESUME[$i]:-}" ;;
    esac
    return 0
  done
  return 1
}

is_claude_cmd() { [ "$(agent_of_cmd "$1" || true)" = claude ]; }

# --- help --------------------------------------------------------------------
# Written out rather than scraped from the header comment: the comment explains
# the design to whoever is editing this file, which is not what someone typing
# `msesh help` wants to read. Keep the two in step by hand — there is not enough
# of either to justify generating one from the other.
#
# Split into topics because the single page this used to be had grown past a
# screen, which is the point at which a manual stops being read at all. The
# default page lists the commands and the four options anyone actually types;
# everything else is one `msesh help TOPIC` away and named in that page.
die() { echo "msesh: $*" >&2; exit 1; }

usage_short() {
  cat <<EOF
usage: msesh COMMAND [OPTIONS] [SPEC...]

  \$ msesh build 4              four shells in a new tab
  \$ msesh build 4 claude       four claude panes instead

Run 'msesh help' for all commands.
EOF
}

help_main() {
  cat <<EOF
NAME
  msesh $MSESH_VERSION — a tmux session of N panes, each running an agent, a
  shell, or any command you name

USAGE
  msesh COMMAND [OPTIONS] [SPEC...]
  msesh build [OPTIONS] [SPEC...]
  msesh help [TOPIC]

DESCRIPTION
  Builds a tmux session of N panes in a new terminal tab and keeps track of it.
  Sessions outlive the tab, survive a reboot, and say when a pane is waiting on
  you. Runs on Linux, macOS, Windows and WSL.

EXAMPLES
  Four shells, tiled, in a new tab:
    \$ msesh build 4

  Three claude panes and a shell, named 'work':
    \$ msesh build 3 claude +shell -s work

  Panes at low, medium and high effort:
    \$ msesh build 3 claude -e ladder

  Name that whole session, then build it whenever:
    \$ msesh layout make quad 4 claude -e l,m,h,x
    \$ msesh build quad

  See what a command would build, without building it:
    \$ msesh build quad --dry-run

COMMANDS
  Building
    build [SPEC...]   build a session, or attach if it is already up
    rebuild [SPEC...] kill this session and build it again
    add [SPEC...]     add panes to a session already up
    attach [NAME]     attach, restoring the session first if it is down

  Keeping
    restore [NAME]    rebuild a session as it was       (--all for every one)
    kill [NAME]       kill a session and its panes      (--all for every one)
    snapshot [NAME]   record a live session, conversations and all
    forget NAME       drop a recorded session
    list              live sessions, layouts, recorded sessions

  Naming
    preset SUBCMD     name a command one pane runs
    layout SUBCMD     name a whole session

  Checking
    status [NAME]     what each pane is doing, and which is waiting
    doctor            check this machine
    send NAME TEXT    type TEXT into every agent pane
    hooks SUBCMD      the turn-end signal from an agent

  Run 'msesh help TOPIC' for detail on any of these.

OPTIONS
  The four you will type most; 'msesh help options' has the rest.

  -s, --session NAME    name the session (default: msesh)
  -d, --dir DIR         working directory for every pane (default: \$PWD)
  -e, --effort LIST     effort for agent panes: 'ladder', or l,m,h,x in order
  -w, --width N         max panes per window before spilling (default: 4)
  -n, --dry-run         print what would be built, build nothing
  -h, --help            show this help
      --version         show the version

EXIT STATUS
  0   success
  1   the command failed
  2   usage error

SEE ALSO
  msesh help specs      how the pane arguments are read
  msesh help options    every option, grouped
  msesh help preset     naming one pane
  msesh help layout     naming a whole session
  msesh help agents     which commands count as an agent
  msesh help hooks      how a pane reports that its turn ended
  msesh help resume     bringing back the conversations, not just the panes
  msesh help files      where msesh keeps things
  msesh help env        environment variables msesh honours

REPORT BUGS
  https://github.com/BlueRaddish/msesh/issues
EOF
}

help_specs() {
  cat <<EOF
NAME
  msesh specs — the pane arguments to build, rebuild and add

USAGE
  msesh build [OPTIONS] [SPEC...]

DESCRIPTION
  A spec says what one pane runs. Specs are read left to right, and may be
  mixed with options in any order. With no spec at all you get one pane of
  the default preset ($DEFAULT_PRESET).

EXAMPLES
  Four panes of the default preset:
    \$ msesh build 4

  Four claude panes instead:
    \$ msesh build 4 claude

  Three claude panes and one shell:
    \$ msesh build 3 claude +shell

  Two claude panes and one running htop:
    \$ msesh build 2 claude '!htop'

  Two of one preset, one of another:
    \$ msesh build claude:2 pwsh:1

ARGUMENTS
  N            N panes of the default preset
  PRESET       one pane of PRESET
  N PRESET     N panes of PRESET
  PRESET:N     N panes of PRESET
  +PRESET      one more pane; the + is decoration
  !COMMAND     one pane running COMMAND as written

  A spec that collides with a command name needs the verb to disambiguate:
  a preset called 'list' is 'msesh build list'.

SEE ALSO
  msesh help preset     what a preset is, and how to add one
  msesh help options    every option a build takes
EOF
}

help_options() {
  cat <<EOF
NAME
  msesh options — every option, grouped

USAGE
  msesh COMMAND [OPTIONS] [SPEC...]

DESCRIPTION
  Only build, rebuild and add read the pane options. A restored session takes
  its settings from its manifest unless you override them on the command line,
  so 'msesh restore work -w 2' is a one-off tweak and 'msesh restore work' is
  the session as it was.

EXAMPLES
  Name a session and put every pane in one directory:
    \$ msesh build 4 -s work -d /c/src/thing

  Check what a line would build, and build nothing:
    \$ msesh build quad --dry-run

  One pane per window, so every pane alerts on its own:
    \$ msesh build 4 claude -w 1

OPTIONS
  Session
    -s, --session NAME   name the session (default: msesh)
    -d, --dir DIR        working directory for every pane (default: \$PWD)
        --ephemeral      kill the session when the tab closes
        --no-tab         build the session without opening a terminal tab
    -n, --dry-run        print what would be built, build nothing

  Panes
    -e, --effort LIST    effort for agent panes, in pane order
    -w, --width N        max panes per window before spilling (default: 4)
        --windows LIST   name the windows this build creates, in order
        --lazy           pre-type agent panes without running them (default)
        --eager          start agent panes straight away (--now is a synonym)

  Notifications
        --notify SECS    toast after SECS of pane silence (default: 20, 0=off)
        --no-notify      same as --notify 0

  Other
        --all            restore or kill every known session, not just one
        --resume         with restore: bring the conversations back too
        --no-trust       skip the workspace-trust pre-seed
        --no-enter       with send: type the text without pressing Enter
    -h, --help           show this help
        --version        show the version

  Four of those carry a rule with them.

  With -e, the letters l/m/h/x expand to low/medium/high/xhigh and 'ladder'
  means low,medium,high; the last level repeats for any panes left over. An
  agent with no effort setting is skipped rather than given one, and a level
  its agent does not have is an error naming both.

  With -w 0, every pane goes in one window however small it gets.

  With --windows, names run out silently: anything past the end falls back to
  m1, m2, … A name shows in the status bar, in the tab title when that window
  is waiting, and in its toast.

  --no-tab is what 'restore --all' uses when it runs from a logon task.

  Silence is the fallback signal. Run 'msesh hooks install' and agent panes
  report the end of a turn themselves; these options then govern only the
  panes that are not agents.

  A toast is gone in seconds and does not say where to look, so the alert also
  lands in three places that stay until you deal with them: the terminal tab
  title, the window's entry in tmux's status bar, and every pane border in
  that window. All three clear when you switch to it. tmux alerts per window,
  never per pane, so the window is what gets marked — build with '-w 1' for an
  alert per pane. MSESH_HIGHLIGHT=0 drops all three and keeps the toast.

SEE ALSO
  msesh help specs      the pane arguments
  msesh help agents     which commands -e and --lazy apply to
  msesh help hooks      the turn-end signal these options fall back from
EOF
}

help_preset() {
  local presets=${MSESH_PRESETS:-$(plat_config_home)/presets.conf}
  cat <<EOF
NAME
  msesh preset — name a command one pane runs

USAGE
  msesh preset list
  msesh preset show NAME
  msesh preset make [NAME] [COMMAND]
  msesh preset remove NAME
  msesh preset edit

DESCRIPTION
  A preset is a name for one pane's command, usable anywhere a spec takes a
  preset name. One pane makes a preset; more than one makes a layout, which
  is a name for a whole session — see 'msesh help layout'.

EXAMPLES
  Write one straight out:
    \$ msesh preset make review "claude /code-review"

  Then use it like any other preset:
    \$ msesh build 4 review

  Leave things out and it asks instead:
    \$ msesh preset make

COMMANDS
  list             every preset, built-ins first, then yours
  show NAME        the command one preset resolves to
  make [NAME]      write a new one, asking for whatever you left out
  remove NAME      delete one of yours
  edit             open the presets file in \$EDITOR

  'make' asks how many panes and what each runs. Answer a pane with a preset
  name, or with a "quoted command" to run that command as written; naming a
  preset that does not exist yet offers to write that one too, which is how
  you add 'codex' or 'gemini' the first time.

FILES
  $presets

  One 'name = command' line each. Yours override a built-in of the same name.

    review = claude --dangerously-skip-permissions /code-review
    watch  = npm run dev

  Built in: shell, then the shells this machine has, then the agents on it —
  each the bare command, with flags left to you. A preset whose command runs
  a known agent is treated as an agent pane: -e injects that agent's effort
  flag, and --lazy leaves it pre-typed rather than started. Everything else
  runs as written.

  For a one-off you do not want to name, use a spec instead:
    \$ msesh build 2 claude '!npm run dev'

SEE ALSO
  msesh help layout     naming a whole session
  msesh help agents     what makes a preset an agent pane
  msesh help specs      where a preset name can appear
EOF
}

help_layout() {
  local dir=${MSESH_LAYOUTS:-$(plat_config_home)/layouts}
  cat <<EOF
NAME
  msesh layout — name a whole session, the way a preset names one pane

USAGE
  msesh layout make NAME [SPEC...] [OPTIONS]
  msesh layout save SESSION [NAME]
  msesh layout list
  msesh layout show NAME
  msesh layout remove NAME
  msesh layout edit NAME

DESCRIPTION
  'layout make' takes the same words you would have typed to build the
  session, and every option a build takes. The layout names the session
  unless -s says otherwise, so building one twice means attaching to the one
  already up, not making a second copy.

EXAMPLES
  Save four claude panes at rising effort:
    \$ msesh layout make quad 4 claude -e ladder

  Build it, as often as you like:
    \$ msesh build quad

  The same session with one option overridden, under another name:
    \$ msesh build quad -e x -s spike

  Save one you already built by hand:
    \$ msesh layout save work repo

COMMANDS
  make NAME        save a session under a name
  save SESSION     save a session you already built
  list             every layout, with its panes
  show NAME        the file behind one
  remove NAME      delete one
  edit NAME        open it in \$EDITOR

  Leave the specs out and 'make' asks instead — how many panes, what each
  runs, where, at what effort.

  A layout is a whole session, so it is used on its own: 'msesh build quad
  +pwsh' and 'msesh build 3 quad' are errors rather than guesses.

FILES
  $dir/

  Sessions msesh recorded for itself are a separate directory in the same
  format — a layout is a definition, a recording is what happened. 'msesh
  forget' drops a recording; only 'msesh layout remove' drops a layout.

SEE ALSO
  msesh help preset     naming one pane
  msesh help files      where both kinds live
EOF
}

# Printed from the table itself rather than written out, so a registration
# added in agents.conf shows up here without anyone remembering to say so.
help_agents() {
  local file=${MSESH_AGENTS:-$(plat_config_home)/agents.conf} i flag levels cmd
  cat <<EOF
NAME
  msesh agents — the pane commands msesh treats as an assistant, not a shell

USAGE
  msesh build [OPTIONS] N AGENT

DESCRIPTION
  Being an agent changes two things: -e adds that agent's own effort flag for
  you, so you can say '-e high' without remembering how each one spells it;
  and the pane opens pre-typed rather than started, because agents are slow
  and expensive and you asked for panes, not for four running assistants.

EXAMPLES
  Three claude panes at low, medium and high:
    \$ msesh build 3 claude -e ladder

  Start them straight away instead of pre-typing:
    \$ msesh build 3 claude --eager

ARGUMENTS
EOF
  printf '  +------------+--------------------+----------------------------+--------------------------+
'
  printf '  | %-10s | %-18s | %-26s | %-24s |
' AGENT COMMAND 'EFFORT FLAG' LEVELS
  printf '  +------------+--------------------+----------------------------+--------------------------+
'
  for i in "${!AGENT_NAMES[@]}"; do
    flag=${AGENT_EFFORT[$i]}; levels=${AGENT_LEVELS[$i]}
    # Resolved directly, not through preset_get: help is dispatched before the
    # presets are registered, so asking them would report everything missing.
    if [ "${AGENT_NAMES[$i]}" = claude ] && [ -n "${CLAUDE_BIN:-}" ]; then
      cmd=$CLAUDE_BIN
    else
      cmd=$(command -v "${AGENT_NAMES[$i]}" 2>/dev/null || true)
    fi
    [ -n "$cmd" ] || cmd='(not installed)'
    [ -n "$flag" ]   || flag='(none)'
    [ -n "$levels" ] || levels='-'
    printf '  | %-10s | %-18.18s | %-26.26s | %-24.24s |
'       "${AGENT_NAMES[$i]}" "$cmd" "$flag" "${levels//,/, }"
  done
  printf '  +------------+--------------------+----------------------------+--------------------------+
'
  cat <<EOF

  A pane is an agent pane if the command it runs is one of the above, so
  'review = claude /code-review' counts without being listed. An agent with
  no effort flag is skipped by -e; a level it does not have is an error
  naming both. -e replaces whatever effort the preset would have used, and a
  preset that already names one is left alone.

FILES
  $file

  One 'name = flag | levels | resume' line each, teaching msesh another
  agent. Each flag carries its own separator:

    myagent    = --reasoning | quick,deep | --continue
    otheragent =                              (no effort setting)

  The third field is the flag that takes a conversation id, and only an agent
  that can be reopened by id has one — see 'msesh help resume'. claude has it;
  codex resumes by recency instead, which is a different thing and is left out
  rather than faked.

SEE ALSO
  msesh help preset     naming an agent's command with flags attached
  msesh help options    -e, --lazy and --eager in full
  msesh help resume     reopening a conversation on restore
EOF
}

help_resume() {
  local dir=${MSESH_STATE:-$(plat_config_home)/sessions}/snapshots
  cat <<EOF
NAME
  msesh resume — bringing back the conversations, not just the panes

USAGE
  msesh snapshot [NAME]
  msesh restore NAME --resume

DESCRIPTION
  A plain restore rebuilds the shape of a session: the right number of panes,
  running the right commands, in the right windows. The agents in them are
  new, and remember nothing. With --resume each pane that had a conversation
  comes back to it, in the directory it was in, at the size it was.

  This needs 'msesh hooks install'. The conversation ids come from a
  SessionStart hook; without it there is nothing to record and --resume has
  nothing to work from.

EXAMPLES
  Record a session you are about to walk away from:
    \$ msesh snapshot work

  Bring it back tomorrow, conversations and all:
    \$ msesh restore work --resume

  See what would come back before doing it:
    \$ msesh restore work --resume --dry-run

COMMANDS
  snapshot [NAME]      record a live session, conversations and all
  restore NAME         rebuild the shape, with fresh agents
  restore NAME --resume rebuild it and reopen every conversation it can

  A snapshot is also taken automatically on 'msesh kill' — that is how a
  session normally ends, and the last moment its conversations can be read.

  Panes are matched to the snapshot by position, because position is the only
  identity a pane has across a kill. A pane whose conversation was never
  recorded, or whose agent cannot be resumed by id, starts fresh: three
  resumed and one new is a normal restore, not a failure. Resumed panes are
  marked with a trailing ~ in their label.

FILES
  $dir/HOST/

  A snapshot is a manifest with a timestamp — the same format and the same
  reader, so nothing had to learn a third concept. Layouts are definitions,
  manifests are recordings, snapshots are the history of recordings, and
  'msesh list' still shows two sections.

  Filed per machine, because a conversation id and an absolute path mean
  nothing on another one. Everything from the last week is kept, then one a
  day for two months, then nothing.

SEE ALSO
  msesh help hooks      the hook that records the conversations
  msesh help agents     which agents can be resumed by id
  msesh help files      where the rest of it lives
EOF
}

help_files() {
  # A path list, not an essay. What each of these is *for* is the business of
  # its own topic; someone typing 'help files' wants to know where to look.
  cat <<EOF
NAME
  msesh files — where msesh keeps things

FILES
  msesh's own:
    presets    ${MSESH_PRESETS:-$(plat_config_home)/presets.conf}
    agents     ${MSESH_AGENTS:-$(plat_config_home)/agents.conf}
    layouts    ${MSESH_LAYOUTS:-$(plat_config_home)/layouts}/
    sessions   ${MSESH_STATE:-$(plat_config_home)/sessions}/

  An agent's own, listed per agent because each keeps hooks somewhere
  different, and 'msesh hooks' is the only thing that touches them:
    claude     $CLAUDE_SETTINGS

  'layouts' holds sessions you defined yourself; 'sessions' holds ones msesh
  saved as you built and killed them. 'build NAME' reads a layout,
  'restore NAME' prefers a recording.

  Two more live inside 'sessions': 'snapshots/HOST/', the history of those
  recordings, and 'agents.map', which conversation is in which pane. Named
  relative to it rather than spelled out again, because a deep state
  directory would push the line past the width this page has to fit in.

SEE ALSO
  msesh help preset     the presets file
  msesh help agents     the agents file
  msesh help layout     layouts against recordings
  msesh help hooks      what msesh writes into an agent's settings
  msesh help env        overriding any of these paths
EOF
}

help_hooks() {
  cat <<EOF
NAME
  msesh hooks — what an agent pane tells msesh about itself

USAGE
  msesh hooks status
  msesh hooks install [--dry-run]
  msesh hooks remove [--dry-run]

DESCRIPTION
  Two hooks, installed and removed together. A Stop hook says a turn has
  ended: without it msesh infers "waiting on you" from silence, which is a
  guess, late by the length of the timeout and wrong in both directions — an
  agent thinking quietly looks finished, one printing steadily never alerts.
  A SessionStart hook records which conversation a pane holds, which is what
  'msesh restore --resume' rebuilds from.

EXAMPLES
  See whether it is on, and what else is in that file:
    \$ msesh hooks status

  Turn it on:
    \$ msesh hooks install

  See exactly what would be written, and write nothing:
    \$ msesh hooks install --dry-run

COMMANDS
  status           report whether they are installed, and what shares the file
  install          add both hooks
  remove           take them out again

OPTIONS
  --dry-run        with install or remove: print the change, write nothing

FILES
  claude     $CLAUDE_SETTINGS

  Named for the agent, not called 'settings', because it is Claude Code's
  file and nothing else's — another agent's hooks go somewhere of its own,
  and would be another row here.

  The Stop hook runs msesh-notify the moment a turn ends: the pane is marked,
  its window lights up, and 'msesh status' shows it as WAITING. Silence
  monitoring stays on for panes that are not agents, where it was always the
  right signal. The SessionStart hook writes the pane's conversation id into
  the map named in 'msesh help files'.

  That file belongs to Claude Code and usually holds hooks you wrote
  yourself, so this command only ever appends, never rewriting, reordering or
  dropping an entry it did not create. It tags everything it writes with
  "_msesh" so remove takes exactly its own, copies the file to
  settings.json.msesh-backup first, parses what it wrote before letting it
  replace anything, and changes nothing on a second install. An install
  followed by a remove leaves the file byte-identical. 'status' never writes.

SEE ALSO
  msesh help options    --notify, the fallback this replaces
  msesh help agents     which panes send the signal
  msesh help resume     what the recorded conversations are for
EOF
}


help_env() {
  cat <<'EOF'
NAME
  msesh env — the environment variables msesh honours

DESCRIPTION
  Everything machine-specific is a variable, so the script itself stays
  portable and this repo can stay public.

EXAMPLES
  Make a bare build launch codex panes instead of shells:
    $ export MSESH_DEFAULT_PRESET=codex

  Keep a waiting window from being marked, without losing the toast:
    $ MSESH_HIGHLIGHT=0 msesh build 4 claude

ENVIRONMENT
  CLAUDE_BIN            the claude executable         (default: from PATH)
  CLAUDE_FLAGS          flags the claude presets run with
  CLAUDE_JSON           claude's config, for the trust pre-seed
  MSESH_DEFAULT_PRESET  what a bare 'msesh build 4' launches   (default: shell)
  MSESH_PRESETS         presets file
  MSESH_AGENTS          agents file
  MSESH_LAYOUTS         layout directory
  MSESH_STATE           manifest directory
  MSESH_NOTIFIER        the toast helper             (default: msesh-notify)
  MSESH_HIGHLIGHT       0 to stop marking a waiting window
  MSESH_TERMINAL        the terminal to open a session in, before the search
  MSESH_NOTIFY_CMD      a command taking TITLE BODY, before the search
  MSESH_OS              override platform detection (linux/macos/windows/wsl)
  MSESH_RUNTIME         which runtime to hand over to (msys2/cygwin)
  MSESH_AGENT_BIN       agent looked for when choosing a runtime  (default: claude)
  MSESH_REAP_AFTER      seconds a closed session lives on         (default: 1800, 0 keeps it)
  MSESH_SNAPSHOT_DAYS   days of session history to keep           (default: 60, 0 keeps all)
  MSESH_SNAPSHOT_FULL_DAYS
                        days kept in full before thinning to one a day (default: 7)
  TMUX_BIN              tmux
  TERMINAL              honoured on Linux, as the usual convention
  MSESH_MSYS_ROOT       on Windows, an MSYS2 install root, if it is unusual
  WT_BIN                on Windows, the Terminal binary
  WT_PROFILE            on Windows, the profile a new tab uses

SEE ALSO
  msesh help files      the paths these variables override
  msesh help agents     what MSESH_AGENTS registers
EOF
}

help_topic() {
  case ${1:-} in
    ''|commands|main)             help_main ;;
    spec|specs|panes)             help_specs ;;
    option|options|flags)         help_options ;;
    preset|presets)               help_preset ;;
    layout|layouts|session)       help_layout ;;
    agent|agents)                 help_agents ;;
    hook|hooks)                   help_hooks ;;
    resume|snapshot|snapshots)    help_resume ;;
    file|files|manifest|manifests) help_files ;;
    env|environment|vars)         help_env ;;
    build|rebuild|add)            help_specs; echo; help_options ;;
    *) echo "msesh: no help topic '$1'" >&2
       echo "topics: specs, options, preset, layout, agents, hooks, resume, files, env" >&2
       exit 1 ;;
  esac
}

# --- commands ----------------------------------------------------------------
# One verb, taken from the first argument, decides what msesh is going to do;
# everything after it is options and positionals for that verb. The alternative
# — the flag-per-action scheme this replaces — meant the difference between
# building a session and destroying every session was one shifted keystroke
# (-k / -K), and nothing on the command line said which you had asked for.
COMMANDS="build rebuild add attach restore kill forget list status send preset layout snapshot doctor hooks help version"

# Did-you-mean. A prefix match either way round is not enough on its own — it
# gets 'lst' but not 'buld', and a dropped letter in the middle is the typo
# people actually make — so this is a real edit distance, in awk because the
# same arithmetic in bash would be a visible pause. Eleven candidates, so the
# cost is irrelevant either way.
suggest_command() {
  printf '%s\n' $COMMANDS | awk -v w="$1" '
    function min3(a, b, c) { return a < b ? (a < c ? a : c) : (b < c ? b : c) }
    {
      split("", d)                     # portable clear; dimensions vary per row
      n = length(w); m = length($0)
      for (i = 0; i <= n; i++) d[i, 0] = i
      for (j = 0; j <= m; j++) d[0, j] = j
      for (i = 1; i <= n; i++)
        for (j = 1; j <= m; j++)
          d[i, j] = min3(d[i-1, j] + 1, d[i, j-1] + 1,
                         d[i-1, j-1] + (substr(w, i, 1) == substr($0, j, 1) ? 0 : 1))
      dist = d[n, m]
      if (index($0, w) == 1) dist = 0  # an abbreviation is not a typo
      if (best == "" || dist < best) { best = dist; pick = $0 }
    }
    END { if (best != "" && best <= 2) print pick }'
}

# A first argument shaped like a spec is someone typing the old flagless form.
# Say so precisely rather than making them read the whole manual to find out
# that a verb is now required.
looks_like_spec() {
  case $1 in
    '!'*|'+'*) return 0 ;;
    *:*)       return 0 ;;
    ''|*[!0-9]*) return 1 ;;
    *)         return 0 ;;
  esac
}

if [ $# -gt 0 ]; then CMD=$1; shift; else CMD=; fi

case $CMD in
  ''|help|--help|-h)  help_topic "${1:-}"; exit 0 ;;
  version|--version)  echo "msesh $MSESH_VERSION"; exit 0 ;;
  build)              ACTION=build ;;
  rebuild)            ACTION=build; FRESH=1 ;;
  add)                ACTION=build; ADD=1 ;;
  attach)             ACTION=build; ATTACH_ONLY=1 ;;
  restore)            ACTION=build; RESTORE=1 ;;
  kill)               ACTION=kill ;;
  snapshot|snap)      ACTION=snapshot ;;
  forget)             ACTION=forget ;;
  list)               ACTION=list ;;
  status)             ACTION=status ;;
  doctor|check)       ACTION=doctor ;;
  hooks)              ACTION=hooks ;;
  send)               ACTION=send ;;
  # Undocumented on purpose: this is the completion scripts' data source, not
  # a verb for people. One name per line, no headers, no styling — 'msesh
  # layout list' is the human version and is free to be rearranged without
  # breaking Tab in two shells.
  complete-names)     ACTION=names ;;
  preset|presets)     ACTION=preset ;;
  layout|layouts)     ACTION=layout ;;
  -?*) usage_short >&2
       die "a command comes first, then its options — '$CMD' needs one in front of it" ;;
  *)   usage_short >&2
       if looks_like_spec "$CMD"; then
         die "'$CMD' is a spec, not a command — try 'msesh build $CMD'"
       fi
       guess=$(suggest_command "$CMD")
       if [ -n "$guess" ]; then
         die "no command '$CMD' — did you mean 'msesh $guess'?"
       fi
       die "no command '$CMD' (msesh help lists them)" ;;
esac

# --- options -----------------------------------------------------------------
# Hand-rolled rather than getopts so that specs and options can interleave, and
# so --long forms work: `msesh build 4 claude --effort ladder` reads better than
# forcing every flag ahead of the count. One loop for every verb — what the
# leftover positionals mean is the verb's business, settled below.
ARGS=()
while [ $# -gt 0 ]; do
  arg=$1; shift
  case $arg in
    --) ARGS+=("$@"); break ;;
    --session=*)  SESSION=${arg#*=}; SESSION_SET=1 ;;
    --dir=*)      WORKDIR=${arg#*=}; DIR_SET=1 ;;
    --effort=*)   EFFORTS_RAW=${arg#*=} ;;
    --width=*)    PANES_PER_WINDOW=${arg#*=}; WIDTH_SET=1 ;;
    --notify=*)   NOTIFY_SILENCE=${arg#*=}; NOTIFY_SET=1 ;;
    --session)    SESSION=${1:?--session needs a value}; shift; SESSION_SET=1 ;;
    --dir)        WORKDIR=${1:?--dir needs a value}; shift; DIR_SET=1 ;;
    --effort)     EFFORTS_RAW=${1:?--effort needs a value}; shift ;;
    --width)      PANES_PER_WINDOW=${1:?--width needs a value}; shift; WIDTH_SET=1 ;;
    --notify)     NOTIFY_SILENCE=${1:?--notify needs a value}; shift; NOTIFY_SET=1 ;;
    --no-notify)  NOTIFY_SILENCE=0; NOTIFY_SET=1 ;;
    --windows=*)  WINDOW_NAMES=${arg#*=}; WINDOWS_SET=1 ;;
    --windows)    WINDOW_NAMES=${1:?--windows needs a value}; shift; WINDOWS_SET=1 ;;
    --lazy)       EAGER=0; EAGER_SET=1 ;;
    --eager|--now) EAGER=1; EAGER_SET=1 ;;
    --ephemeral)  EPHEMERAL=1 ;;
    --no-tab)     OPEN_TAB=0 ;;
    --no-trust)   PRESEED_TRUST=0 ;;
    --dry-run|-n) DRY_RUN=1 ;;
    --no-enter)   SEND_ENTER=0 ;;
    --all)        ALL=1 ;;
    --resume)     RESUME=1 ;;
    -s) SESSION=${1:?-s needs a value}; shift; SESSION_SET=1 ;;
    -d) WORKDIR=${1:?-d needs a value}; shift; DIR_SET=1 ;;
    -e) EFFORTS_RAW=${1:?-e needs a value}; shift ;;
    -w) PANES_PER_WINDOW=${1:?-w needs a value}; shift; WIDTH_SET=1 ;;
    # The short form, not the whole manual: an error you have to scroll back
    # through to read is worse than no error.
    -?*) usage_short >&2; echo "try 'msesh help options' for every option" >&2
         die "unknown option: $arg" ;;
    *)  ARGS+=("$arg") ;;
  esac
done

# --- what the positionals meant ----------------------------------------------
# Session verbs take a name; build verbs take specs. Both are positional so the
# common case is one word with no flag around it.
SPECS=()
PRESET_ARGS=()
LAYOUT_ARGS=()
SEND_TEXT=()

# One name, or none. Every session verb reads its positional the same way, so
# 'msesh kill work' and 'msesh restore work' cannot drift apart.
take_session_name() {
  if [ "${#ARGS[@]}" -gt 1 ]; then
    die "$CMD takes one session name, got ${#ARGS[@]} arguments"
  fi
  if [ "${#ARGS[@]}" = 1 ]; then SESSION=${ARGS[0]}; SESSION_SET=1; fi
  return 0
}

case $ACTION in
  build)
    # attach and restore name a session; build, rebuild and add describe one
    if [ "$ATTACH_ONLY" = 1 ] || [ "$RESTORE" = 1 ]; then
      take_session_name
    else
      SPECS=(${ARGS[@]+"${ARGS[@]}"})
    fi ;;
  kill|status|snapshot)
    take_session_name ;;
  forget)
    if [ "${#ARGS[@]}" = 0 ] && [ "$ALL" = 0 ]; then
      die "forget needs a session name (msesh list shows what is known)"
    fi
    take_session_name
    FORGET=$SESSION ;;
  hooks)
    HOOKS_SUB=${ARGS[0]:-status} ;;
  names)
    : ;;                                # its positional is read where it is used
  preset)
    PRESET_SUB=${ARGS[0]:-list}
    if [ "${#ARGS[@]}" -gt 1 ]; then PRESET_ARGS=("${ARGS[@]:1}"); fi ;;
  send)
    # Session name first and required, never defaulted: this types into every
    # agent in a session at once, and the one mistake worth designing out is
    # sending to a session you did not mean.
    if [ "${#ARGS[@]}" -lt 2 ]; then
      die "send needs a session and something to type: msesh send work \"/clear\""
    fi
    SESSION=${ARGS[0]}; SESSION_SET=1
    # An optional target between the session and the text: a pane number, a
    # pane label, or 'all'. Taken as a target only when there is text after it
    # and it looks like one — so 'msesh send work 2' still types "2" into the
    # session rather than silently addressing pane 2 and sending nothing.
    SEND_TEXT=("${ARGS[@]:1}")
    if [ "${#ARGS[@]}" -ge 3 ]; then
      case ${ARGS[1]} in
        all|ALL)            SEND_TARGET=all;      SEND_TEXT=("${ARGS[@]:2}") ;;
        ''|*[!0-9]*)        SEND_TARGET_MAYBE=${ARGS[1]} ;;   # a label, checked later
        *)                  SEND_TARGET=${ARGS[1]}; SEND_TEXT=("${ARGS[@]:2}") ;;
      esac
    fi ;;
  layout)
    LAYOUT_SUB=${ARGS[0]:-list}
    if [ "${#ARGS[@]}" -gt 1 ]; then LAYOUT_ARGS=("${ARGS[@]:1}"); fi ;;
esac

# --all turns the single-session verbs into their sweep. Kept as a flag rather
# than a separate verb so there is one name to remember per action.
if [ "$ALL" = 1 ]; then
  # send is the exception: its --all widens which *panes* are typed into, not
  # which sessions, and it still needs the session named.
  if [ "$ACTION" = send ]; then
    SEND_ALL=1
  elif [ "${#ARGS[@]}" != 0 ]; then die "--all takes no session name"; fi
  case $ACTION in
    send)  : ;;
    kill)  ACTION=killall ;;
    build) if [ "$RESTORE" != 1 ]; then
             die "--all only means something to 'restore' and 'kill'"
           fi
           ACTION=restoreall ;;
    *)     die "--all only means something to 'restore' and 'kill'" ;;
  esac
fi

# --- locate tmux ------------------------------------------------------------
# Where tmux is depends entirely on the machine, so the platform layer answers.
TMUX_BIN=$(plat_tmux)
# 'doctor' exists to report a missing tmux, so it is the one verb that must
# survive one.
[ -x "$TMUX_BIN" ] || [ "$ACTION" = doctor ] || die "tmux not found ($TMUX_BIN)"

session_exists() { "$TMUX_BIN" has-session -t "=$1" 2>/dev/null; }

# A name for a session nobody named. The directory you are standing in is a
# better guess than a constant: it is what the session is *about*, it differs
# between projects so two builds do not collide, and it is what you would have
# typed. Sanitised to the characters a session name may hold, and falling back
# to the old constant when nothing survives that.
session_name_from_dir() {
  local n=${PWD##*/}
  n=$(printf '%s' "$n" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//; s/-*$//')
  [ -n "$n" ] || n=msesh
  printf '%s' "$n"
}

# What to say when a verb that acts on a session was not told which one.
# Guessing is how 'msesh restore' quietly resurrected a session called msesh:
# the default name was a constant, so the command always had *something* to
# act on and never looked like it was missing an argument.
name_required() {
  local verb=$1
  printf 'msesh: %s needs a session name.\n\n' "$verb" >&2
  local any=0 n
  printf 'running now:\n' >&2
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    any=1; printf '  %s\n' "$n" >&2
  done < <("$TMUX_BIN" list-sessions -F '#{session_name}' 2>/dev/null || true)
  [ "$any" = 1 ] || printf '  (none)\n' >&2
  any=0
  printf 'closed, but recorded:\n' >&2
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    session_is_live "$n" && continue
    any=1; printf '  %s\n' "$n" >&2
  done < <(manifest_names 2>/dev/null || true)
  [ "$any" = 1 ] || printf '  (none)\n' >&2
  printf '\n  msesh %s NAME\n' "$verb" >&2
  case $verb in
    kill)    printf '  msesh kill --all        every session msesh built\n' >&2 ;;
    restore) printf '  msesh restore NAME --resume   reopen the conversations too\n' >&2 ;;
  esac
  exit 2
}

# The same question asked about a whole list at once. 'list' used to call
# session_exists per name, which is one tmux process each — sixteen of them on
# a machine with a few layouts, at ~30ms a spawn, for an answer one call could
# have given. The names are cached on first use because nothing can start a
# session in the middle of printing a list.
_LIVE_SESSIONS=
_live_loaded=0
session_is_live() {
  if [ "$_live_loaded" = 0 ]; then
    _LIVE_SESSIONS=$("$TMUX_BIN" list-sessions -F '#{session_name}' 2>/dev/null || true)
    _live_loaded=1
  fi
  case "
$_LIVE_SESSIONS
" in *"
$1
"*) return 0 ;; esac
  return 1
}

# --- presets ----------------------------------------------------------------
# Built-ins first, then the user file overrides by name. `claude` expands the
# `cly` alias by hand: that alias lives in ~/.bashrc and bash only expands
# aliases in interactive shells, while tmux runs pane commands through a
# non-interactive one.
CLAUDE_BIN=${CLAUDE_BIN:-$(command -v claude || echo claude)}
# Empty by default. This used to carry --remote-control and
# --dangerously-skip-permissions, which meant every claude pane msesh started
# had permission prompts turned off without saying so.
CLAUDE_FLAGS=${CLAUDE_FLAGS:-}

PRESET_NAMES=()
PRESET_CMDS=()

preset_set() {
  local i
  for i in "${!PRESET_NAMES[@]}"; do
    if [ "${PRESET_NAMES[$i]}" = "$1" ]; then PRESET_CMDS[$i]=$2; return; fi
  done
  PRESET_NAMES+=("$1"); PRESET_CMDS+=("$2")
}

preset_get() {
  local i
  presets_probe                 # first read is what pays for the probing
  for i in "${!PRESET_NAMES[@]}"; do
    if [ "${PRESET_NAMES[$i]}" = "$1" ]; then printf '%s' "${PRESET_CMDS[$i]}"; return 0; fi
  done
  return 1
}

# The shell a pane gets when nothing else was asked for: yours, not msesh's
# idea of one. tmux's own default-shell first, because that is what tmux would
# have started and it already honours the user's tmux.conf; then $SHELL; then
# whatever exists. Used for the `shell` preset and as the thing a pane falls
# back to when its command exits.
PANE_SHELL=$("$TMUX_BIN" show-options -gv default-shell 2>/dev/null || true)
if [ -z "$PANE_SHELL" ] || [ ! -x "$PANE_SHELL" ]; then PANE_SHELL=${SHELL:-}; fi
if [ -z "$PANE_SHELL" ] || [ ! -x "$PANE_SHELL" ]; then
  PANE_SHELL=$(command -v bash || command -v sh || echo /bin/sh)
fi

# --- built-in presets ---------------------------------------------------------
# Ordered by how ordinary they are, because that is the order they are listed
# in and the order someone reads them: a shell first, the shells you actually
# have next, agents last. Agents are the reason msesh exists, but they are the
# specialised end of the list, not the front of it.
#
# Every one of these is the bare command. A preset that quietly added flags —
# and the claude preset used to add --dangerously-skip-permissions — is a
# preset that does something you did not ask for and cannot see. Flags are
# yours to add, either in presets.conf or through CLAUDE_FLAGS.
preset_set shell "$PANE_SHELL -i"

# Which shells and agents this machine actually has — a preset list offering
# cmd.exe on Linux is lying about the machine.
#
# Deferred, because finding out is expensive and most commands never ask. Each
# probe is a PATH walk, and a *miss* walks all of it; under WSL that PATH
# carries every Windows directory, so one miss costs ~50ms over 9P and eight of
# them cost 400 — which 'msesh list' was paying to learn about agents it had no
# intention of mentioning. Built on first use instead, which for list, kill,
# status, version and help is never.
_presets_probed=0
presets_probe() {
  [ "$_presets_probed" = 0 ] || return 0
  _presets_probed=1
  local _pname _pcmd _a
  while IFS== read -r _pname _pcmd; do
    [ -n "$_pname" ] && preset_set "$_pname" "$_pcmd"
  done <<EOF
$(plat_shell_presets)
EOF
  # Agents, from the same table that knows how to spell their effort flags —
  # rather than a second hand-written list that could disagree with it.
  for _a in ${AGENT_NAMES[@]+"${AGENT_NAMES[@]}"}; do
    if [ "$_a" = claude ] && [ -n "${CLAUDE_BIN:-}" ] && [ -x "$CLAUDE_BIN" ]; then
      preset_set claude "$CLAUDE_BIN${CLAUDE_FLAGS:+ $CLAUDE_FLAGS}"
    elif command -v "$_a" >/dev/null 2>&1; then
      preset_set "$_a" "$_a"
    fi
  done
}

PRESET_FILE=${MSESH_PRESETS:-$(plat_config_home)/presets.conf}
if [ -r "$PRESET_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%$'\r'}                         # tolerate CRLF
    case $line in ''|'#'*) continue ;; esac
    case $line in *=*) ;; *) continue ;; esac
    pname=${line%%=*}; pcmd=${line#*=}
    # trim surrounding whitespace from both halves
    pname=$(printf '%s' "$pname" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    pcmd=$(printf '%s' "$pcmd"   | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    [ -n "$pname" ] && [ -n "$pcmd" ] && preset_set "$pname" "$pcmd"
  done < "$PRESET_FILE"
fi


# --- manifests --------------------------------------------------------------
# A tmux session survives its tab closing but not the machine restarting, and
# not the tmux server dying. Every build therefore records what it was made of,
# so the session can be rebuilt byte-identically later. Manifests are keyed by
# session name and rewritten on each build.
MANIFEST_DIR=${MSESH_STATE:-$(plat_config_home)/sessions}
manifest_of() { printf '%s/%s.conf' "$MANIFEST_DIR" "$1"; }

manifest_save() {
  local f; f=$(manifest_of "$SESSION")
  mkdir -p "$MANIFEST_DIR" || return 0

  # 'add' describes the panes it is adding, not the session as a whole, so its
  # specs belong after the ones already recorded. Writing only the new panes —
  # which is what this did — left the manifest describing the addition alone,
  # so a restore rebuilt the pane you added and lost every pane it was added
  # to. Skipped when the specs came out of this same manifest a moment ago,
  # or they would be written back twice.
  local prior=() line
  if [ "$ADD" = 1 ] && [ "$MANIFEST_LOADED" = 0 ] && [ -r "$f" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case ${line%%$'\r'} in spec=*) prior+=("${line#spec=}") ;; esac
    done < "$f"
  fi

  {
    echo "# msesh manifest for '$SESSION' — rewritten on every build"
    echo "# restore with: msesh restore $SESSION"
    printf 'version=%s\n' "$MSESH_FORMAT"
    printf 'dir=%s\n'     "$WORKDIR"
    printf 'effort=%s\n'  "$EFFORTS_RAW"
    printf 'eager=%s\n'   "$EAGER"
    printf 'width=%s\n'   "$PANES_PER_WINDOW"
    printf 'notify=%s\n'  "$NOTIFY_SILENCE"
    printf 'windows=%s\n' "$WINDOW_NAMES"
    local s
    for s in ${prior[@]+"${prior[@]}"}; do printf 'spec=%s\n' "$s"; done
    for s in ${SPECS[@]+"${SPECS[@]}"}; do printf 'spec=%s\n' "$s"; done
  } > "$f.tmp" && mv "$f.tmp" "$f"
}

# --- snapshots ----------------------------------------------------------------
# A snapshot is a manifest with a timestamp. Not a third concept: same format,
# same reader, same directory tree — layouts stay definitions, manifests stay
# recordings, and snapshots are the history of recordings. 'msesh list' gains
# no third section.
#
# It exists because a manifest is written at build time, when the thing worth
# recording does not exist yet: an agent's conversation id is assigned when it
# starts, and with panes pre-typed rather than started it may not exist for
# hours. So the id is collected from the live session instead — on 'kill',
# which is how a session normally ends, and on demand.
SNAPSHOT_DIR=$MANIFEST_DIR/snapshots
AGENTS_MAP=$MANIFEST_DIR/agents.map

# pane id -> conversation id, from the map the SessionStart hook writes.
resume_id_of() {
  [ -r "$AGENTS_MAP" ] || return 1
  local pane=$1 line
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      "$pane	"*) line=${line#*	}; printf '%s' "${line%%	*}"; return 0 ;;
    esac
  done < "$AGENTS_MAP"
  return 1
}

# Kept: everything under a week, one a day for the next two months, nothing
# older. Snapshots are small, but a session snapshotted on every kill for a
# year is thousands of files in a directory people occasionally ls.
# Thinning, not deleting: everything for the first week, then one a day, then
# nothing. The two edges are settable because "how long is history worth
# keeping" is a judgement about the machine, not about msesh — Claude Code
# makes the same call adjustable as cleanupPeriodDays, and defaults it to 30.
# MSESH_SNAPSHOT_DAYS=0 keeps everything, for anyone who would rather spend the
# kilobytes than think about it.
SNAPSHOT_FULL_DAYS=${MSESH_SNAPSHOT_FULL_DAYS:-7}
SNAPSHOT_DAYS=${MSESH_SNAPSHOT_DAYS:-60}

snapshot_prune() {
  local dir=$1 now day keep f base stamp age
  now=$(date +%s 2>/dev/null) || return 0
  for f in "$dir"/*.conf; do
    [ -e "$f" ] || continue
    base=${f##*/}
    stamp=${base%.conf}; stamp=${stamp##*-}         # trailing unix time
    case $stamp in ''|*[!0-9]*) continue ;; esac    # not ours; leave it alone
    age=$(( (now - stamp) / 86400 ))
    [ "$age" -lt "$SNAPSHOT_FULL_DAYS" ] && continue
    if [ "$SNAPSHOT_DAYS" != 0 ] && [ "$age" -gt "$SNAPSHOT_DAYS" ]; then rm -f "$f"; continue; fi
    day=$(( stamp / 86400 ))
    eval "keep=\${_snap_day_$day:-}"
    if [ -n "$keep" ]; then rm -f "$f"; else eval "_snap_day_$day=1"; fi
  done
}

# Writes the live shape of a session: which pane holds which conversation,
# where each one is, and the exact tmux geometry. Silent and successful when
# there is nothing to record — this runs from 'kill', and a session that
# cannot be snapshotted must still be killable.
snapshot_write() {
  local sess=$1 dir now f
  session_exists "$sess" || return 1
  now=$(date +%s 2>/dev/null) || return 1
  dir=$SNAPSHOT_DIR/$(plat_host 2>/dev/null || echo local)
  mkdir -p "$dir" 2>/dev/null || return 1
  f=$dir/$sess-$now.conf

  {
    echo "# msesh snapshot of '$sess' — $(date 2>/dev/null)"
    echo "# restore with: msesh restore $sess --resume"
    printf 'version=%s\n' "$MSESH_FORMAT"
    printf 'snapshot=%s\n' "$now"
    # The build options, taken from the manifest so a snapshot restores like
    # the session did rather than like today's defaults.
    if [ -r "$(manifest_of "$sess")" ]; then
      grep -E '^(dir|effort|eager|width|notify|windows|spec)=' "$(manifest_of "$sess")" 2>/dev/null
    fi
    # Exact geometry rather than re-tiling: a session someone has resized is
    # not the same session after a restore that tiles it evenly again.
    "$TMUX_BIN" list-windows -t "=$sess" \
      -F 'window=#{window_index}|#{window_name}|#{window_layout}' 2>/dev/null
    # Pane order is the restore order, so it is listed in tmux's order and
    # matched back positionally.
    local pid widx label agent path rid
    while IFS='|' read -r pid widx label agent path; do
      [ -n "$pid" ] || continue
      rid=$(resume_id_of "$pid" 2>/dev/null || true)
      printf 'pane=%s|%s|%s|%s|%s\n' "$widx" "$label" "$agent" "$path" "$rid"
    done < <("$TMUX_BIN" list-panes -s -t "=$sess" \
      -F '#{pane_id}|#{window_index}|#{@label}|#{@agent}|#{pane_current_path}' 2>/dev/null)
  } > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f" 2>/dev/null || { rm -f "$f.tmp"; return 1; }

  snapshot_prune "$dir"
  printf '%s' "$f"
}

# The newest snapshot for a session, or nothing.
snapshot_newest() {
  local sess=$1 dir f newest= newest_stamp=0 base stamp
  dir=$SNAPSHOT_DIR/$(plat_host 2>/dev/null || echo local)
  [ -d "$dir" ] || return 1
  for f in "$dir/$sess"-*.conf; do
    [ -e "$f" ] || continue
    base=${f##*/}; stamp=${base%.conf}; stamp=${stamp##*-}
    case $stamp in ''|*[!0-9]*) continue ;; esac
    [ "$stamp" -gt "$newest_stamp" ] && { newest_stamp=$stamp; newest=$f; }
  done
  [ -n "$newest" ] || return 1
  printf '%s' "$newest"
}

# Fills in SPECS and the build options, but never overrides a flag the user
# typed on this invocation — restoring with a tweak should be one flag, not a
# manifest edit. Returns non-zero when there is nothing to read.
#
# One reader for both kinds of file: a layout is the same format as a manifest,
# written on purpose rather than recorded, and the whole point of keeping the
# formats identical is that nothing downstream has to know which it got.
MANIFEST_LOADED=0

conf_read() {
  local f=$1 key val line
  [ -r "$f" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%$'\r'}
    case $line in ''|'#'*) continue ;; *=*) ;; *) continue ;; esac
    key=${line%%=*}; val=${line#*=}
    case $key in
      dir)    [ "$DIR_SET" = 0 ] && WORKDIR=$val ;;
      effort) [ -z "$EFFORTS_RAW" ] && EFFORTS_RAW=$val ;;
      eager)  [ "$EAGER_SET" = 0 ] && EAGER=$val ;;
      width)  [ "$WIDTH_SET" = 0 ] && PANES_PER_WINDOW=$val ;;
      notify) [ "$NOTIFY_SET" = 0 ] && NOTIFY_SILENCE=$val ;;
      windows) [ "$WINDOWS_SET" = 0 ] && WINDOW_NAMES=$val ;;
      spec)   SPECS+=("$val") ;;
      layout) ;;                       # marker only; see the layouts section
      # Louder than a silent misreading, quieter than refusing to work: a
      # newer msesh's file is likely still mostly readable, and saying which
      # file and which version beats a build that comes out subtly wrong.
      #
      # Only a *newer* file is worth saying anything about. Reading an older
      # one is the ordinary case after an upgrade — every manifest on disk is
      # written by whatever msesh built it — and warning about those would put
      # a line of noise in front of every restore anyone had recorded before.
      version)
        case $val in
          ''|*[!0-9]*) echo "msesh: $f has a non-numeric version '$val' — reading it anyway" >&2 ;;
          *) [ "$val" -le "$MSESH_FORMAT" ] ||
               echo "msesh: $f is format $val, this msesh knows $MSESH_FORMAT — reading it anyway" >&2 ;;
        esac ;;
    esac
  done < "$f"
  return 0
}

manifest_load() {
  conf_read "$(manifest_of "$1")" || return 1
  MANIFEST_LOADED=1
  return 0
}

manifest_names() {
  local f n
  for f in "$MANIFEST_DIR"/*.conf; do
    [ -e "$f" ] || continue
    n=${f##*/}; printf '%s\n' "${n%.conf}"
  done
}

# --- layouts -----------------------------------------------------------------
# A preset names one pane. A layout names a whole session: how many panes, what
# each runs, where, at what effort — 'four claude panes on a low-medium-high
# ladder in this repo' as one word you can type.
#
# Same format as a manifest, but a separate directory, because the two are
# different things that happen to be written alike. A manifest is a recording
# of what was running and is rewritten by every build; a layout is something
# you wrote down and expect to still say what you wrote. Sharing one directory
# meant `msesh build quad` recorded over the definition of 'quad' it had just
# read, `msesh add` edited it, and `msesh forget` deleted it.
LAYOUT_DIR=${MSESH_LAYOUTS:-$(plat_config_home)/layouts}
layout_of()     { printf '%s/%s.conf' "$LAYOUT_DIR" "$1"; }
layout_exists() { [ -r "$(layout_of "$1")" ]; }
layout_load()   { conf_read "$(layout_of "$1")"; }

layout_names() {
  local f n
  for f in "$LAYOUT_DIR"/*.conf; do
    [ -e "$f" ] || continue
    n=${f##*/}; printf '%s\n' "${n%.conf}"
  done
}

# Layouts written by 0.2–0.4 went into the manifest directory, where they are
# now indistinguishable from recordings and will be overwritten by the first
# build that reuses the name. They named themselves in their header, so move
# them once and say so, rather than leaving a trap for whoever upgrades.
layout_migrate() {
  local f n
  [ -d "$MANIFEST_DIR" ] || return 0
  for f in "$MANIFEST_DIR"/*.conf; do
    [ -e "$f" ] || continue
    # Read the first line in the shell rather than spawning head and grep for
    # it. This runs on *every* invocation, once per recorded session, so on a
    # machine with a dozen of them it was two dozen processes before msesh had
    # done anything — and it is looking for a header written by a version from
    # 0.2 to 0.4, which almost no file will ever have.
    IFS= read -r _first < "$f" 2>/dev/null || continue
    case $_first in '# msesh layout '*) ;; *) continue ;; esac
    n=${f##*/}; n=${n%.conf}
    layout_exists "$n" && continue
    mkdir -p "$LAYOUT_DIR" || return 0
    mv "$f" "$(layout_of "$n")" &&
      echo "msesh: moved layout '$n' into $LAYOUT_DIR" >&2
  done
}
layout_migrate

# --- writing presets ---------------------------------------------------------
# Editing presets.conf by hand is fine and stays supported, but it means
# knowing the file exists, where it is, and what the syntax is before you can
# name your first command. These write it for you.

# The name becomes a key in presets.conf and, for a layout, a filename. One
# rule covering both is easier to explain than two.
preset_name_ok() {
  case $1 in
    '') die "a preset needs a name" ;;
    *[!A-Za-z0-9._-]*)
      die "preset names take letters, digits, dot, dash and underscore — got '$1'" ;;
  esac
  return 0
}

# Rewrites the whole file rather than appending, so making a preset that
# already exists updates it in place instead of leaving two lines where the
# second silently wins.
preset_file_set() {
  local name=$1 cmd=$2 tmp replaced=0 line bare n
  mkdir -p "$(dirname "$PRESET_FILE")"
  if [ ! -e "$PRESET_FILE" ]; then
    printf '# msesh presets — one "name = command" per line.\n' > "$PRESET_FILE"
  fi
  tmp=$PRESET_FILE.msesh.tmp
  while IFS= read -r line || [ -n "$line" ]; do
    bare=${line%%$'\r'}
    case $bare in
      *=*)
        n=${bare%%=*}
        n=$(printf '%s' "$n" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        if [ "$n" = "$name" ]; then
          printf '%s = %s\n' "$name" "$cmd"; replaced=1
        else
          printf '%s\n' "$bare"
        fi ;;
      *) printf '%s\n' "$bare" ;;
    esac
  done < "$PRESET_FILE" > "$tmp"
  [ "$replaced" = 1 ] || printf '%s = %s\n' "$name" "$cmd" >> "$tmp"
  mv "$tmp" "$PRESET_FILE"
}

# Non-zero when the name was not in the file, so the caller can tell "removed"
# from "there was nothing of yours by that name".
preset_file_unset() {
  local name=$1 tmp found=0 line bare n
  [ -r "$PRESET_FILE" ] || return 1
  tmp=$PRESET_FILE.msesh.tmp
  while IFS= read -r line || [ -n "$line" ]; do
    bare=${line%%$'\r'}
    case $bare in
      *=*)
        n=${bare%%=*}
        n=$(printf '%s' "$n" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        if [ "$n" = "$name" ]; then found=1; else printf '%s\n' "$bare"; fi ;;
      *) printf '%s\n' "$bare" ;;
    esac
  done < "$PRESET_FILE" > "$tmp"
  if [ "$found" = 1 ]; then mv "$tmp" "$PRESET_FILE"; else rm -f "$tmp"; fi
  [ "$found" = 1 ]
}

layout_save() {
  local name=$1 dir=$2 effort=$3 width=$4 notify=$5 windows=$6; shift 6
  local f; f=$(layout_of "$name")
  mkdir -p "$LAYOUT_DIR" || die "cannot write to $LAYOUT_DIR"
  {
    echo "# msesh layout '$name' — a whole session, written on purpose"
    echo "# launch with: msesh build $name"
    printf 'version=%s\n' "$MSESH_FORMAT"
    printf 'layout=1\n'
    printf 'dir=%s\n'    "$dir"
    printf 'effort=%s\n' "$effort"
    printf 'eager=1\n'
    printf 'width=%s\n'  "$width"
    printf 'notify=%s\n' "$notify"
    printf 'windows=%s\n' "$windows"
    local s
    for s in "$@"; do printf 'spec=%s\n' "$s"; done
  } > "$f.tmp" && mv "$f.tmp" "$f"
}

# Prompts go to stderr so that a wizard run with its answers piped in still
# writes only its result to stdout. EOF is an abort, not an empty answer —
# otherwise a closed stdin walks the whole questionnaire accepting defaults.
ask() {
  local prompt=$1 default=$2 __var=$3 reply
  if [ -n "$default" ]; then printf '%s [%s]: ' "$prompt" "$default" >&2
  else                       printf '%s: ' "$prompt" >&2; fi
  if ! IFS= read -r reply; then printf '\n' >&2; die "aborted"; fi
  [ -n "$reply" ] || reply=$default
  printf -v "$__var" '%s' "$reply"
}

# Asks what each of COUNT panes runs, leaving the answers in WIZ_SPECS. Shared
# by both wizards: a layout and a multi-pane preset are described the same way,
# and asking the question twice in two voices is how they drift apart.
WIZ_SPECS=()

wizard_panes() {
  local panes=$1 specs=() i=1 choice pcmd
  while [ "$i" -le "$panes" ]; do
    ask "  pane $i — a preset name, or a \"literal command\"" "$DEFAULT_PRESET" choice
    case $choice in
      # A quoted answer is a command to run as-is, which is what the ! spec
      # means. Accepting the quotes the user typed rather than making them
      # learn the ! is the whole point of asking.
      \"*\"|\'*\')
        pcmd=${choice:1:${#choice}-2}
        [ -n "$pcmd" ] || die "empty command for pane $i"
        specs+=("!$pcmd") ;;
      '!'*)
        specs+=("$choice") ;;
      *)
        if ! preset_get "$choice" >/dev/null; then
          echo "    '$choice' is not a preset yet." >&2
          ask "    command for '$choice' (blank to give up)" "" pcmd
          [ -n "$pcmd" ] || die "no command for '$choice' — nothing written"
          preset_name_ok "$choice"
          preset_file_set "$choice" "$pcmd"
          preset_set "$choice" "$pcmd"
          echo "    added preset '$choice' = $pcmd" >&2
        fi
        specs+=("$choice") ;;
    esac
    i=$((i + 1))
  done
  WIZ_SPECS=("${specs[@]}")
}

# The session-level half: everything a layout knows that a preset cannot.
WIZ_DIR= WIZ_EFFORT= WIZ_WIDTH= WIZ_NOTIFY= WIZ_WINDOWS=

wizard_settings() {
  ask "Working directory" "$PWD" WIZ_DIR
  [ -d "$WIZ_DIR" ] || die "no such directory: $WIZ_DIR"
  ask "Effort for agent panes — blank, 'ladder', or l,m,h" "" WIZ_EFFORT
  ask "Max panes per window" "4" WIZ_WIDTH
  case $WIZ_WIDTH in ''|*[!0-9]*) die "width must be a number, got '$WIZ_WIDTH'" ;; esac
  # Asked after the width, because until that is answered you do not know how
  # many windows there will be to name.
  ask "Window names, comma separated (blank for m1, m2, …)" "" WIZ_WINDOWS
  ask "Toast after this many seconds of silence (0 = off)" "20" WIZ_NOTIFY
  case $WIZ_NOTIFY in ''|*[!0-9]*) die "notify must be seconds, got '$WIZ_NOTIFY'" ;; esac
}

preset_make() {
  local name=${PRESET_ARGS[0]:-} cmd=${PRESET_ARGS[1]:-}

  if [ "${#PRESET_ARGS[@]}" -gt 2 ]; then
    die "preset make takes a name and one quoted command — try: msesh preset make $name \"claude --effort high\""
  fi

  # Told everything up front: no questions. This is the form to put in a script.
  if [ -n "$name" ] && [ -n "$cmd" ]; then
    preset_name_ok "$name"
    preset_file_set "$name" "$cmd"
    echo "msesh: preset '$name' = $cmd"
    echo "msesh: use it with 'msesh build 4 $name'"
    return 0
  fi

  [ -n "$name" ] || ask "Name" "" name
  preset_name_ok "$name"
  if preset_get "$name" >/dev/null; then
    echo "msesh: '$name' already exists — this will replace it" >&2
  fi

  local panes
  ask "How many panes" "1" panes
  case $panes in ''|*[!0-9]*) die "panes must be a number, got '$panes'" ;; esac
  [ "$panes" -ge 1 ] || die "a preset needs at least one pane"

  wizard_panes "$panes"

  # One pane is a name for a command; several is a name for a session. Asking
  # the pane count first means the answer decides which of the two you get, so
  # someone who came here for a preset and described a session still gets one.
  if [ "$panes" = 1 ]; then
    local pcmd
    case ${WIZ_SPECS[0]} in
      '!'*) pcmd=${WIZ_SPECS[0]#!} ;;
      *)    pcmd=$(preset_get "${WIZ_SPECS[0]}") ;;
    esac
    preset_file_set "$name" "$pcmd"
    echo "msesh: preset '$name' = $pcmd"
    echo "msesh: use it with 'msesh build $name' or 'msesh build 4 $name'"
    return 0
  fi

  wizard_settings
  layout_save "$name" "$WIZ_DIR" "$WIZ_EFFORT" "$WIZ_WIDTH" "$WIZ_NOTIFY" "$WIZ_WINDOWS" "${WIZ_SPECS[@]}"
  echo "msesh: layout '$name' — $panes panes in $WIZ_DIR"
  echo "msesh: launch it with 'msesh build $name'"
}

# 'layout make NAME [SPECS]' — the same words you would have typed to build it,
# saved instead of run. That is the form worth having: anyone who can describe
# a session on the command line can name one without learning a second syntax,
# and the options were already parsed into the same variables a build uses.
# With no specs it asks instead.
layout_make() {
  local name=${LAYOUT_ARGS[0]:-} specs=()
  [ "${#LAYOUT_ARGS[@]}" -gt 1 ] && specs=("${LAYOUT_ARGS[@]:1}")

  [ -n "$name" ] || ask "Name" "" name
  preset_name_ok "$name"
  layout_exists "$name" &&
    echo "msesh: layout '$name' already exists — this will replace it" >&2
  # Not fatal, but worth saying: 'msesh build NAME' will mean the layout, and
  # the preset of the same name becomes reachable only inside a spec list.
  preset_get "$name" >/dev/null &&
    echo "msesh: note — '$name' is also a preset; the layout is what 'msesh build $name' will use" >&2

  if [ "${#specs[@]}" = 0 ]; then
    local panes
    ask "How many panes" "1" panes
    case $panes in ''|*[!0-9]*) die "panes must be a number, got '$panes'" ;; esac
    [ "$panes" -ge 1 ] || die "a layout needs at least one pane"
    wizard_panes "$panes"
    wizard_settings
    specs=("${WIZ_SPECS[@]}")
  else
    # Whatever was not given takes the same default a build would have used,
    # so 'layout make quad 4 claude' is exactly the session that command line
    # would have built.
    WIZ_DIR=$WORKDIR
    WIZ_EFFORT=$EFFORTS_RAW
    WIZ_WIDTH=$PANES_PER_WINDOW
    WIZ_NOTIFY=$NOTIFY_SILENCE
    WIZ_WINDOWS=$WINDOW_NAMES
    [ -d "$WIZ_DIR" ] || die "no such directory: $WIZ_DIR"
  fi

  layout_save "$name" "$WIZ_DIR" "$WIZ_EFFORT" "$WIZ_WIDTH" "$WIZ_NOTIFY" "$WIZ_WINDOWS" "${specs[@]}"
  echo "msesh: layout '$name' — ${specs[*]} in $WIZ_DIR"
  echo "msesh: launch it with 'msesh build $name'"
}

# Keeping a session you built by hand. The manifest already describes it, so
# this is a copy with the header rewritten — no reading panes back out of tmux,
# and it works on a session that has since been closed.
layout_from_session() {
  local sess=${LAYOUT_ARGS[0]:-} name=${LAYOUT_ARGS[1]:-}
  [ -n "$sess" ] || die "layout save needs a session name (msesh list shows them)"
  [ -n "$name" ] || name=$sess
  preset_name_ok "$name"
  local src; src=$(manifest_of "$sess")
  [ -r "$src" ] ||
    die "no manifest for '$sess' — only a session msesh built can be saved as a layout"

  # Read it through the same loader a build uses rather than copying the file,
  # so a manifest written by an older msesh is normalised on the way in.
  SPECS=()
  conf_read "$src" || die "cannot read $src"
  [ "${#SPECS[@]}" -gt 0 ] || die "'$sess' has no panes recorded"
  layout_save "$name" "$WORKDIR" "$EFFORTS_RAW" "$PANES_PER_WINDOW" "$NOTIFY_SILENCE" "$WINDOW_NAMES" \
    "${SPECS[@]}"
  echo "msesh: layout '$name' — from the session '$sess'"
  echo "msesh: launch it with 'msesh build $name'"
}

# --- side-effect actions ----------------------------------------------------
list_sessions() {
  # -F is a format string, but a plain one with no #{} braces for a Windows
  # shell to mangle on the way to tmux.exe.
  "$TMUX_BIN" list-sessions 2>/dev/null || { echo "msesh: no tmux server running"; return 0; }
}

# Which verbs may not guess. Acting on "whatever the default name happens to
# be" is how 'msesh restore' brought back a session called msesh instead of
# saying it had not been told what to restore — the constant default meant
# there was always something to act on, so a missing argument never looked
# like one. Building may still guess, because building invents a session
# rather than finding one; it takes the directory's name and says so.
if [ "$SESSION_SET" = 0 ]; then
  case $ACTION in
    kill|status|snapshot|forget|send) name_required "$ACTION" ;;
    build)
      if   [ "$RESTORE" = 1 ];     then name_required restore
      elif [ "$ATTACH_ONLY" = 1 ]; then name_required attach
      else
        SESSION=$(session_name_from_dir)
        [ "$DRY_RUN" = 1 ] || [ "$ADD" = 1 ] ||
          echo "msesh: no -s given, so naming it '$SESSION' after this directory"
      fi ;;
  esac
fi

case $ACTION in
  list)
    echo "live:"
    list_sessions | sed 's/^/  /'
    # Two sections because they are two different things: a layout is a session
    # you described, a manifest is one msesh recorded. Showing them in one list
    # is what made a layout feel like a by-product rather than the thing you
    # wrote.
    echo "layouts (build with msesh build NAME):"
    found=0
    while IFS= read -r n; do
      found=1
      if session_is_live "$n"; then printf '  %-16s up\n' "$n"
      else                         printf '  %s\n'       "$n"; fi
    done < <(layout_names)
    [ "$found" = 1 ] || echo "  (none yet — 'msesh layout make NAME 4 claude -e ladder')"
    echo "recorded sessions (restore with msesh restore NAME):"
    found=0
    while IFS= read -r n; do
      found=1
      if session_is_live "$n"; then printf '  %-16s up\n' "$n"
      else                         printf '  %-16s down\n' "$n"; fi
    done < <(manifest_names)
    [ "$found" = 1 ] || echo "  (none yet)"
    exit 0 ;;
  names)
    # Never fails and never says why: a completion function runs on every Tab,
    # and an error message printed into the middle of someone's command line
    # is worse than no completion at all.
    case ${ARGS[0]:-commands} in
      commands) printf '%s\n' $COMMANDS ;;
      presets)  presets_probe; printf '%s\n' ${PRESET_NAMES[@]+"${PRESET_NAMES[@]}"} ;;
      layouts)  layout_names 2>/dev/null ;;
      manifests) manifest_names 2>/dev/null ;;
      sessions) "$TMUX_BIN" list-sessions -F '#S' 2>/dev/null ;;
      # What 'build' can take: a layout, a preset, or a session to attach to.
      buildable) presets_probe; { layout_names; printf '%s\n' ${PRESET_NAMES[@]+"${PRESET_NAMES[@]}"}
                   "$TMUX_BIN" list-sessions -F '#S' 2>/dev/null; } 2>/dev/null | sort -u ;;
      restorable) { layout_names; manifest_names; } 2>/dev/null | sort -u ;;
      topics)   printf '%s
' specs options preset layout agents hooks resume files env ;;
      *) : ;;
    esac
    exit 0 ;;
  send)
    session_exists "$SESSION" || die "no session '$SESSION' (msesh list)"
    # The arguments are joined rather than sent one per pane: 'msesh send work
    # /clear' and 'msesh send work "look at src/"' should both mean one line
    # typed, and quoting a sentence is something people forget.
    # A bare word between session and text is a target only if it names a pane
    # here; otherwise it was the first word of the message.
    if [ -n "$SEND_TARGET_MAYBE" ]; then
      if "$TMUX_BIN" list-panes -s -t "=$SESSION" -F '#{@label}' 2>/dev/null |
           grep -qx -- "$SEND_TARGET_MAYBE"; then
        SEND_TARGET=$SEND_TARGET_MAYBE
        SEND_TEXT=("${ARGS[@]:2}")
      fi
    fi
    [ "$SEND_ALL" != 1 ] || SEND_TARGET=all
    [ "${#SEND_TEXT[@]}" -gt 0 ] ||
      die "send needs something to type: msesh send $SESSION ${SEND_TARGET:-2} \"hello\""

    text=${SEND_TEXT[*]}
    targets=(); skipped=0; unstarted=0; unstarted_labels=()
    while IFS='|' read -r pid pagent plabel pcmd pidx; do
      [ -n "$pid" ] || continue
      # Naming a pane means it: a shell is a perfectly good thing to type into,
      # and second-guessing an explicit target is how a tool stops being
      # useful. Only the unaddressed case picks for you, and it picks agents.
      if [ -n "$SEND_TARGET" ]; then
        case $SEND_TARGET in
          all) : ;;
          *)   [ "$pidx" = "$SEND_TARGET" ] || [ "$plabel" = "$SEND_TARGET" ] || continue ;;
        esac
        targets+=("$pid|${plabel:-$pidx}")
        continue
      fi
      if [ -z "$pagent" ]; then
        skipped=$((skipped + 1)); continue
      fi
      # A lazy pane has the agent's command *typed* and not run, so its
      # foreground process is still the shell. Sending to it does not reach an
      # agent — it appends to that unexecuted line and eats it, leaving the
      # pane worse off than before, which msesh then reported as a success.
      # An agent that is actually running is the foreground process, so the
      # shell is the tell.
      if printf '%s\n' $(plat_shell_commands) | grep -qx -- "$pcmd"; then
        unstarted=$((unstarted + 1)); unstarted_labels+=("${plabel:-$pidx}"); continue
      fi
      targets+=("$pid|$plabel")
    done < <("$TMUX_BIN" list-panes -s -t "=$SESSION" \
      -F '#{pane_id}|#{@agent}|#{@label}|#{pane_current_command}|#{pane_index}' 2>/dev/null)

    if [ "${#targets[@]}" = 0 ]; then
      if [ -n "$SEND_TARGET" ]; then
        printf "msesh: '%s' has no pane %s. Its panes are:\n" "$SESSION" "$SEND_TARGET" >&2
        # >&2 before 2>/dev/null: the other order points stdout at a stderr
        # that has already been sent to /dev/null, and the list vanishes.
        "$TMUX_BIN" list-panes -s -t "=$SESSION" \
          -F '  #{pane_index}  #{@label}  (#{pane_current_command})' >&2 2>/dev/null
        printf '\n  msesh send %s NUMBER|LABEL|all "text"\n' "$SESSION" >&2
        exit 2
      fi
      [ "$skipped" = 0 ] && [ "$unstarted" = 0 ] && die "no panes in '$SESSION'"
      if [ "$unstarted" != 0 ]; then
        ul=$(printf '%s, ' "${unstarted_labels[@]}"); ul=${ul%, }
        printf "msesh: nothing in '%s' is running an agent yet — %s still have the command typed and not run (%s).\n" \
          "$SESSION" "$unstarted" "$ul" >&2
        printf '  press Enter in the pane to start it, or name the pane to type at its shell anyway:\n' >&2
        printf '    msesh send %s 1 "%s"\n' "$SESSION" "$text" >&2
        exit 2
      fi
      die "no agent panes in '$SESSION' — name a pane to type into one: msesh send $SESSION 1 \"$text\""
    fi

    for t in "${targets[@]}"; do
      # -l is literal: without it tmux reads the text as key names, so a
      # message containing 'Enter' or 'C-c' would be pressed rather than typed.
      "$TMUX_BIN" send-keys -l -t "${t%%|*}" -- "$text"
      [ "$SEND_ENTER" = 1 ] && "$TMUX_BIN" send-keys -t "${t%%|*}" Enter
    done
    labels=$(printf '%s, ' "${targets[@]#*|}"); labels=${labels%, }
    if [ "$SEND_ENTER" = 1 ]; then
      echo "msesh: sent to ${#targets[@]} pane(s) in '$SESSION' — $labels"
    else
      echo "msesh: typed into ${#targets[@]} pane(s) in '$SESSION', not submitted — $labels"
    fi
    [ "$skipped" != 0 ] && echo "msesh: skipped $skipped non-agent pane(s)"
    if [ "$unstarted" != 0 ]; then
      ul=$(printf '%s, ' "${unstarted_labels[@]}"); ul=${ul%, }
      echo "msesh: skipped $unstarted pane(s) whose agent is not started yet — $ul"
    fi
    exit 0 ;;
  hooks)
    # Claude Code fires a Stop hook the moment a turn ends. That is the signal
    # msesh spent its whole life not having: silence monitoring is a guess that
    # is late by the length of the timeout and wrong in both directions. One
    # line in the user's settings turns the guess into a fact.
    #
    # This is the most invasive thing msesh does. ~/.claude/settings.json is not
    # msesh's file — it belongs to Claude Code and it commonly carries hooks the
    # user wrote, which on this machine include a WIP autocommit and a session
    # archiver. A bad write there does not break msesh; it silently stops the
    # user's own hooks running, and they find out days later. So:
    #
    #   append-only   msesh never rewrites, reorders or drops an entry it did
    #                 not create
    #   tagged        every entry msesh writes carries "_msesh": 1, so remove
    #                 takes exactly its own and nothing adjacent
    #   backed up     settings.json.msesh-backup, written before any change
    #   idempotent    installing twice changes nothing the second time
    #   inspectable   status is read-only, --dry-run prints and writes nothing
    py=$(command -v python3 || command -v python || true)
    [ -n "$py" ] || die "hooks needs python (it edits a JSON file safely)"
    NOTIFIER=${MSESH_NOTIFIER:-$SELF_DIR/msesh-notify}
    # An absolute path, resolved now: the hook runs in the agent's environment,
    # which may not have this directory on PATH at all.
    # Read the flag the parser already set, never re-scan ARGS for it: the
    # global option loop consumes --dry-run/-n into DRY_RUN and does not put it
    # back, so a second scan here matches nothing and silently means "not a dry
    # run" — which turned 'hooks install --dry-run' into a real install of the
    # most invasive thing msesh does. Any subcommand wanting a global flag must
    # read its variable.
    dry=$DRY_RUN
    # Two hooks, installed and removed together as one unit, because they are
    # one feature: Stop says a turn ended, SessionStart says which conversation
    # the pane holds. Having only the first is what msesh shipped in v1.1.0;
    # having only the second would record ids nothing ever reads.
    "$py" - "$CLAUDE_SETTINGS" "$HOOKS_SUB" "$dry" \
      "Stop=\"$NOTIFIER\" --turn-end" \
      "Notification=\"$NOTIFIER\" --needs-input" \
      "UserPromptSubmit=\"$NOTIFIER\" --resumed" \
      "SessionStart=\"$NOTIFIER\" --session-start" <<'PY'
import json, os, shutil, sys

path, action, dry = sys.argv[1], sys.argv[2], sys.argv[3] == '1'
WANT = []
for spec in sys.argv[4:]:
    ev, _, cmd = spec.partition('=')
    WANT.append((ev, cmd))

try:
    with open(path, encoding='utf-8') as fh:
        cfg = json.load(fh)
except FileNotFoundError:
    cfg = {}
except ValueError as e:
    print("msesh: %s is not valid JSON (%s) — refusing to touch it" % (path, e),
          file=sys.stderr)
    sys.exit(1)

hooks = cfg.setdefault('hooks', {}) if isinstance(cfg.get('hooks', {}), dict) else {}

def mine(h):
    if not isinstance(h, dict):
        return False
    if h.get('_msesh') == 1:
        return True
    # Untagged, but unmistakably ours: an entry naming this notifier that msesh
    # did not write is one somebody hand-wrote, or an older msesh left behind.
    # Treating it as a stranger meant remove refused to touch it and install
    # added a second copy beside it — two hooks, two toasts per turn. Matching
    # on the command as well makes install idempotent against both.
    cmd = h.get('command') or ''
    return 'msesh-notify' in cmd

def scan(event):
    groups = hooks.get(event, [])
    installed = [h for g in groups if isinstance(g, dict)
                   for h in g.get('hooks', []) if mine(h)]
    others = sum(1 for g in groups if isinstance(g, dict)
                   for h in g.get('hooks', []) if not mine(h))
    return groups, installed, others

if action in ('status', 'show'):
    print("settings:  %s" % path)
    total_mine = 0
    for event, hook_cmd in WANT:
        groups, installed, others = scan(event)
        total_mine += len(installed)
        print("%s hooks:  %d total, %d msesh, %d yours"
              % (event, len(installed) + others, len(installed), others))
        for h in installed:
            print("  msesh -> %s" % h.get('command'))
        if not installed:
            print("  msesh is not installed — 'msesh hooks install' adds it")
            print("  it would add: %s" % hook_cmd)
    sys.exit(0 if total_mine == len(WANT) else 1)

if action in ('install', 'add'):
    changed = False
    for event, hook_cmd in WANT:
        groups, installed, _ = scan(event)
        if any(h.get('command') == hook_cmd for h in installed):
            continue
        # A stale msesh entry (an old path, a renamed prefix) is replaced rather
        # than doubled: two of them would toast twice per turn.
        for g in groups:
            if isinstance(g, dict):
                g['hooks'] = [h for h in g.get('hooks', []) if not mine(h)]
        groups = [g for g in groups
                  if not (isinstance(g, dict) and not g.get('hooks') and g.get('_msesh') == 1)]
        groups.append({'_msesh': 1,
                       'hooks': [{'type': 'command', 'command': hook_cmd, '_msesh': 1}]})
        hooks[event] = groups
        changed = True
    if not changed:
        print("msesh: hooks already installed — nothing to do")
        sys.exit(0)
    cfg['hooks'] = hooks
    verb = 'would add'
elif action in ('remove', 'uninstall', 'rm'):
    changed = False
    for event, _cmd in WANT:
        groups, installed, _ = scan(event)
        if not installed:
            continue
        for g in groups:
            if isinstance(g, dict):
                g['hooks'] = [h for h in g.get('hooks', []) if not mine(h)]
        # Drop only the empty groups msesh itself created. An empty group
        # belonging to someone else is theirs to keep.
        groups = [g for g in groups
                  if not (isinstance(g, dict) and g.get('_msesh') == 1 and not g.get('hooks'))]
        if groups:
            hooks[event] = groups
        else:
            hooks.pop(event, None)
        changed = True
    if not changed:
        print("msesh: no msesh hook in %s — nothing to remove" % path)
        sys.exit(0)
    cfg['hooks'] = hooks
    verb = 'would remove'
else:
    print("msesh: no hooks command '%s' (install, status, remove)" % action,
          file=sys.stderr)
    sys.exit(1)

if dry:
    print("msesh: %s the turn-end and session-start hooks in %s" % (verb, path))
    print("--- settings.json would become ---")
    print(json.dumps(cfg, indent=2))
    sys.exit(0)

if os.path.exists(path):
    shutil.copy2(path, path + '.msesh-backup')
tmp = path + '.msesh.tmp'
os.makedirs(os.path.dirname(path), exist_ok=True)
# newline='' — without it python's text mode rewrites every \n as \r\n on
# Windows, so adding one hook silently changed every line in the user's
# settings.json and the documented "install then remove leaves it as it was"
# was false on the platform msesh is most used on.
with open(tmp, 'w', encoding='utf-8', newline='') as fh:
    json.dump(cfg, fh, indent=2)
    fh.write('\n')
# Read it back before it replaces anything: a file this one cannot parse is a
# file Claude Code cannot parse, and that is the failure worth never shipping.
with open(tmp, encoding='utf-8') as fh:
    json.load(fh)
os.replace(tmp, path)
print("msesh: %s %s in %s" % (verb.replace('would ', ''),
                              'the turn-end and session-start hooks', path))
if os.path.exists(path + '.msesh-backup'):
    print("msesh: previous settings kept at %s.msesh-backup" % path)
PY
    rc=$?

    # codex reports through one command for every event rather than a hook per
    # event, and its config is TOML, so it is a second installer rather than a
    # fourth entry in the list above. Only the one event exists — see
    # msesh-notify's --agent-notify for what the shipped binary can actually
    # emit — so a codex pane can say it has finished and never that it is
    # blocked on you.
    if [ -n "$py" ] && [ -d "$CODEX_DIR" ] || [ -f "$CODEX_CONFIG" ]; then
      "$py" - "$CODEX_CONFIG" "$HOOKS_SUB" "$dry" "$NOTIFIER" <<'PY'
import os, shutil, sys, re

path, action, dry, notifier = sys.argv[1], sys.argv[2], sys.argv[3] == '1', sys.argv[4]
MARK = '# msesh'                       # tags the line so remove takes its own
line = 'notify = ["%s", "--agent-notify"]  %s\n' % (notifier.replace('\\', '\\\\'), MARK)

try:
    text = open(path, encoding='utf-8').read()
except OSError:
    text = ''

existing = re.search(r'(?m)^\s*notify\s*=.*$', text)
ours = existing and MARK in existing.group(0)

if action in ('install', 'add'):
    if existing and not ours:
        print("msesh: codex already has its own notify= and msesh will not touch it")
        sys.exit(0)
    if ours and existing.group(0).strip() == line.strip():
        sys.exit(0)                    # already exactly right
    new = re.sub(r'(?m)^\s*notify\s*=.*$\n?', '', text) if existing else text
    new = line + new
    if dry:
        print("msesh: would set codex notify in %s" % path); sys.exit(0)
    if os.path.exists(path):
        shutil.copy(path, path + '.msesh-backup')
    os.makedirs(os.path.dirname(path), exist_ok=True)
    open(path, 'w', encoding='utf-8').write(new)
    print("msesh: codex will report the end of a turn (%s)" % path)
elif action in ('remove', 'uninstall', 'rm'):
    if not ours:
        sys.exit(0)
    if dry:
        print("msesh: would remove codex notify from %s" % path); sys.exit(0)
    shutil.copy(path, path + '.msesh-backup')
    open(path, 'w', encoding='utf-8').write(re.sub(r'(?m)^\s*notify\s*=.*$\n?', '', text))
    print("msesh: removed codex notify from %s" % path)
else:
    print("msesh: codex notify %s" % ("installed" if ours else "not installed"))
PY
    fi

    if [ "$HOOKS_SUB" = install ] && [ "$dry" = 0 ] && [ "$rc" = 0 ]; then
      echo "msesh: agent panes will now report the end of a turn immediately;"
      echo "msesh: the silence timer stays as the fallback for everything else"
    fi
    exit $rc ;;
  doctor)
    # Everything install.sh checks, plus the things that only go wrong later.
    # The installer says all this once, at a moment when it is easy to miss and
    # impossible to come back to; this is the same information on demand, from
    # whichever shell is behaving oddly.
    ok=0; bad=0
    say() { printf '  %-4s %-22s %s\n' "$1" "$2" "$3"
            if [ "$1" = ok ]; then ok=$((ok + 1)); else bad=$((bad + 1)); fi; }

    echo "msesh $MSESH_VERSION — $0"

    # What this machine looked like to the platform layer. First, because
    # every check under it depends on these answers, and because "which
    # notifier did you pick" is the question a silent toast actually poses.
    say ok platform "$(plat_os)"

    # Whether panes will redraw at a usable speed. The difference between
    # runtimes here is measured in orders of magnitude, not percent, so it
    # belongs next to the platform line rather than buried at the bottom.
    rendering=$(plat_rendering)
    say "${rendering%% *}" rendering "${rendering#* }"

    if [ -x "$TMUX_BIN" ]; then
      say ok tmux "$("$TMUX_BIN" -V 2>/dev/null || echo "$TMUX_BIN")"
    else
      say FAIL tmux "not found ($TMUX_BIN) — install tmux, or set TMUX_BIN"
    fi

    if opener=$(plat_tab_opener); then
      say ok terminal "$opener"
    else
      say warn terminal "none found — sessions build fine, attach yourself"
    fi

    if notifier=$(plat_notifier); then
      say ok notifier "$notifier"
    else
      say warn notifier "none found — alerts fall back to a tmux message"
    fi

    if command -v "$CLAUDE_BIN" >/dev/null 2>&1 || [ -x "$CLAUDE_BIN" ]; then
      say ok claude "$CLAUDE_BIN"
    else
      say warn claude "not on PATH — the claude presets will fail, others are fine"
    fi

    # The check that earns this command. On Windows, ~/bin on the User PATH in
    # the registry is what makes msesh work from PowerShell, cmd, the Run box
    # and VS Code; a line in .bashrc looks identical from bash and fails
    # everywhere else, which cost three days once. On Unix the shell rc *is*
    # the answer — the advice is inverted between platforms, which is why both
    # spellings live in the platform layer rather than here.
    #
    # Checked against the msesh that is *on* PATH, not the one being run: this
    # file may well be a clone you are testing from, whose directory has no
    # business being on PATH. If nothing is on PATH at all, that is the finding.
    onpath=$(command -v msesh 2>/dev/null || true)
    if [ -z "$onpath" ]; then
      say FAIL PATH "no msesh on this shell's PATH — run ./install.sh"
    else
      bindir=$(cd "$(dirname "$onpath")" && pwd)
      case $(plat_path_check "$bindir") in
        ok)      say ok PATH "$bindir" ;;
        unknown) say warn PATH "could not tell whether $bindir is on PATH" ;;
        *)       say FAIL PATH "$bindir is not on PATH"
                 plat_path_hint "$bindir" | sed 's/^/       /' ;;
      esac
    fi

    # The copy-on-install trap: install.sh copies, so an edited clone and an
    # installed msesh can disagree, and the one on PATH is the one that runs.
    if [ -n "$onpath" ] && [ "$onpath" != "$0" ]; then
      if [ "$(plat_checksum "$onpath")" = "$(plat_checksum "$0")" ]; then
        say ok "installed copy" "$onpath (same)"
      else
        say warn "installed copy" "$onpath differs from $0 — re-run ./install.sh"
      fi
    elif [ -n "$onpath" ]; then
      # Running the installed copy, which is the normal way and the direction
      # that actually needs warning about: you edited the clone, forgot to
      # install, and this stale one is what runs. It has nothing to compare
      # against on its own, so install.sh leaves a note saying where it came
      # from. Absent note means an older install, not a problem — say nothing.
      srcnote="$(dirname "$onpath")/.msesh-source"
      if [ -r "$srcnote" ]; then
        srcdir=$(head -1 "$srcnote" 2>/dev/null)
        if [ -n "$srcdir" ] && [ -r "$srcdir/bin/msesh" ]; then
          if [ "$(plat_checksum "$srcdir/bin/msesh")" = "$(plat_checksum "$onpath")" ]; then
            say ok "installed copy" "matches its source ($srcdir)"
          else
            say warn "installed copy" "older than $srcdir/bin/msesh — re-run ./install.sh"
          fi
        elif [ -n "$srcdir" ]; then
          say ok "installed copy" "source $srcdir is gone; nothing to compare"
        fi
      fi
    fi

    # The difference between knowing a turn ended and guessing from silence.
    if [ -r "$CLAUDE_SETTINGS" ] &&
       grep -q '"_msesh"' "$CLAUDE_SETTINGS" 2>/dev/null; then
      say ok "claude hooks" "installed in $CLAUDE_SETTINGS"
    else
      say warn "claude hooks" "not installed — alerts fall back to the silence timer ('msesh hooks install')"
    fi

    # The platform layer has to be installed beside msesh or nothing above
    # this line would have run — worth stating, since it is a new file that an
    # older install.sh would not have copied.
    if [ -r "$SELF_DIR/msesh-platform" ]; then
      say ok "platform layer" "$SELF_DIR/msesh-platform"
    else
      say FAIL "platform layer" "missing beside $0 — re-run ./install.sh"
    fi

    # Say when a path was redirected, and by what. "Exists and is readable" is
    # not the question anyone is actually asking here — the question is
    # whether it is the file you meant — and a healthy-looking row for a
    # directory pointed somewhere else once cost forty minutes hunting a
    # layout that had never gone missing. Naming the variable answers it in
    # the row rather than in a debugging session.
    via() {  # via VAR_NAME -> " (via VAR_NAME)" when that variable is set
      eval "[ -n \"\${$1:-}\" ]" && printf ' (via %s)' "$1"
      return 0
    }

    for pair in "presets:$PRESET_FILE:MSESH_PRESETS" "agents:$AGENT_FILE:MSESH_AGENTS"; do
      lbl=${pair%%:*}; rest=${pair#*:}; f=${rest%:*}; var=${rest##*:}
      src=$(via "$var")
      if [ ! -e "$f" ];   then say ok "$lbl" "none yet ($f)$src"
      elif [ -r "$f" ];   then say ok "$lbl" "$f$src"
      else                     say FAIL "$lbl" "$f is not readable$src"; fi
    done

    for pair in "layouts:$LAYOUT_DIR:MSESH_LAYOUTS" "manifests:$MANIFEST_DIR:MSESH_STATE"; do
      lbl=${pair%%:*}; rest=${pair#*:}; d=${rest%:*}; var=${rest##*:}
      src=$(via "$var")
      [ -n "$src" ] || src=$(via MSESH_HOME)
      if mkdir -p "$d" 2>/dev/null && [ -w "$d" ]; then say ok "$lbl" "$d$src"
      else say FAIL "$lbl" "$d is not writable$src"; fi
    done

    echo
    if [ "$bad" = 0 ]; then echo "msesh: $ok checks passed"
    else echo "msesh: $ok passed, $bad want attention"; exit 1; fi
    exit 0 ;;
  status)
    # What the toast and the highlight say, but from outside the session: you
    # can ask this from any shell without attaching, which is the whole point.
    #
    # Silence is a window property in tmux — there is no per-pane flag — so
    # "waiting" is reported per window, and the panes under it are listed so
    # you know what is in the one that wants you. Whether a pane's command is
    # still running is read from the foreground process: msesh appends
    # the user's shell to keep a pane alive, so a pane showing a shell is one
    # whose command has exited.
    stat_sessions=()
    if [ "$SESSION_SET" = 1 ]; then
      session_exists "$SESSION" || die "no session '$SESSION' (msesh list)"
      stat_sessions=("$SESSION")
    else
      while IFS= read -r s; do
        [ -n "$s" ] || continue
        [ "$("$TMUX_BIN" show-options -t "$s" -qv @msesh 2>/dev/null || true)" = 1 ] || continue
        stat_sessions+=("$s")
      done < <("$TMUX_BIN" list-sessions -F '#S' 2>/dev/null || true)
    fi
    if [ "${#stat_sessions[@]}" = 0 ]; then
      echo "msesh: no msesh sessions running"
      exit 0
    fi
    for s in "${stat_sessions[@]}"; do
      echo "$s:"
      lastwin=
      while IFS='|' read -r widx wname wsil wbell pidx plabel pcmd pdead pdone pturn; do
        [ -n "$widx" ] || continue
        if [ "$widx" != "$lastwin" ]; then
          state=
          [ "$wsil" = 1 ] && state=' — waiting'
          [ "$wbell" = 1 ] && state=' — bell'
          printf '  window %s (%s)%s\n' "$widx" "$wname" "$state"
          lastwin=$widx
        fi
        # A dead pane means remain-on-exit was set by hand; msesh does not set
        # it, but say so rather than reporting the corpse as idle.
        if [ "$pdead" = 1 ]; then note=dead
        elif [ "$pturn" = waiting ]; then note='WAITING — turn ended'
        elif [ "$pdone" = 1 ]; then note='finished — shell only'
        # Deliberately not printing pcmd here: for a pane msesh built it is the
        # wrapper shell whatever is actually running, so it would read as
        # 'running (bash)' for a working claude pane and mislead.
        else                       note='running'
        fi
        printf '    %-2s %-22s %s\n' "$pidx" "${plabel:-?}" "$note"
      done < <("$TMUX_BIN" list-panes -s -t "=$s" \
        -F '#{window_index}|#{window_name}|#{window_silence_flag}|#{window_bell_flag}|#{pane_index}|#{@label}|#{pane_current_command}|#{pane_dead}|#{@done}|#{@turn}' \
        2>/dev/null)
    done
    exit 0 ;;
  forget)
    f=$(manifest_of "$FORGET")
    if [ -e "$f" ]; then rm -f "$f"; echo "msesh: forgot '$FORGET'"
    else echo "msesh: no recorded session '$FORGET'"; fi
    # forget drops a recording, never a definition — otherwise tidying up after
    # a session would silently delete the layout it was built from.
    layout_exists "$FORGET" &&
      echo "msesh: the layout '$FORGET' is untouched ('msesh layout remove $FORGET' to drop that too)"
    exit 0 ;;
  restoreall)
    any=0
    while IFS= read -r n; do
      if session_exists "$n"; then
        echo "msesh: '$n' already up"; any=1; continue
      fi
      echo "msesh: restoring '$n'"
      # Re-entering the script keeps one code path for building, and --no-tab
      # means a logon task can bring everything back without stealing focus.
      "$0" restore "$n" --no-tab && any=1
    done < <(manifest_names)
    [ "$any" = 1 ] || echo "msesh: nothing to restore"
    exit 0 ;;
  preset)
    # Sub-verbs rather than more top-level commands: 'list' and 'show' are far
    # too generic to own a word of their own at the top level, and grouping
    # them means everything about presets is behind one thing to remember.
    case $PRESET_SUB in
      list|ls)
        presets_probe
        echo "presets (built-in, then ${PRESET_FILE}):"
        for i in "${!PRESET_NAMES[@]}"; do
          printf '  %-10s %s\n' "${PRESET_NAMES[$i]}" "${PRESET_CMDS[$i]}"
        done
        [ -r "$PRESET_FILE" ] || echo "  (no user presets file at $PRESET_FILE)"
        ;;
      show|cat)
        pname=${PRESET_ARGS[0]:-}
        [ -n "$pname" ] || die "preset show needs a name (msesh preset list)"
        pcmd=$(preset_get "$pname") || die "no preset '$pname' (msesh preset list)"
        printf '%s\n' "$pcmd"
        ;;
      make|new)
        preset_make
        ;;
      remove|rm|delete)
        pname=${PRESET_ARGS[0]:-}
        [ -n "$pname" ] || die "preset remove needs a name (msesh preset list)"
        if preset_file_unset "$pname"; then
          echo "msesh: removed preset '$pname'"
          # A removed override uncovers the built-in underneath it, which is a
          # surprise unless it is said out loud.
          case $pname in
            shell|bash|sh|zsh|fish|pwsh|ps|cmd|claude|codex|gemini|aider)
              echo "msesh: '$pname' is a built-in again — see 'msesh preset show $pname'" ;;
          esac
        elif preset_get "$pname" >/dev/null; then
          die "'$pname' is a built-in — it has nothing in $PRESET_FILE to remove"
        else
          die "no preset '$pname' (msesh preset list)"
        fi
        ;;
      edit)
        mkdir -p "$(dirname "$PRESET_FILE")"
        if [ ! -e "$PRESET_FILE" ]; then
          printf '# msesh presets — one "name = command" per line.\n' > "$PRESET_FILE"
        fi
        ed=${VISUAL:-${EDITOR:-}}
        if [ -z "$ed" ]; then ed=$(command -v nano || command -v vi || true); fi
        [ -n "$ed" ] ||
          die "no \$EDITOR, and no nano or vi — edit $PRESET_FILE yourself"
        $ed "$PRESET_FILE"
        ;;
      *) die "no preset command '$PRESET_SUB' (msesh help preset)" ;;
    esac
    exit 0 ;;
  layout)
    case $LAYOUT_SUB in
      list|ls)
        echo "layouts (build one with 'msesh build NAME'):"
        found=0
        while IFS= read -r n; do
          found=1
          # The pane list is what you actually want to be reminded of, and it
          # is one line, so there is no reason to make 'show' the only way.
          specs=$(sed -n 's/^spec=//p' "$(layout_of "$n")" 2>/dev/null | paste -sd ' ' -)
          printf '  %-16s %s\n' "$n" "$specs"
        done < <(layout_names)
        [ "$found" = 1 ] || echo "  (none yet — 'msesh layout make NAME 4 claude -e ladder')"
        ;;
      show|cat)
        lname=${LAYOUT_ARGS[0]:-}
        [ -n "$lname" ] || die "layout show needs a name (msesh layout list)"
        layout_exists "$lname" || die "no layout '$lname' (msesh layout list)"
        cat "$(layout_of "$lname")"
        ;;
      make|new)
        layout_make
        ;;
      save|from)
        layout_from_session
        ;;
      remove|rm|delete)
        lname=${LAYOUT_ARGS[0]:-}
        [ -n "$lname" ] || die "layout remove needs a name (msesh layout list)"
        layout_exists "$lname" || die "no layout '$lname' (msesh layout list)"
        rm -f "$(layout_of "$lname")"
        echo "msesh: removed layout '$lname'"
        ;;
      edit)
        lname=${LAYOUT_ARGS[0]:-}
        [ -n "$lname" ] || die "layout edit needs a name (msesh layout list)"
        layout_exists "$lname" || die "no layout '$lname' (msesh layout list)"
        ed=${VISUAL:-${EDITOR:-}}
        if [ -z "$ed" ]; then ed=$(command -v nano || command -v vi || true); fi
        [ -n "$ed" ] ||
          die "no \$EDITOR, and no nano or vi — edit $(layout_of "$lname") yourself"
        $ed "$(layout_of "$lname")"
        ;;
      *) die "no layout command '$LAYOUT_SUB' (msesh help layout)" ;;
    esac
    exit 0 ;;
  snapshot)
    session_exists "$SESSION" ||
      die "no session '$SESSION' to snapshot — a snapshot is taken from a live session (msesh list)"
    snap=$(snapshot_write "$SESSION") ||
      die "could not write a snapshot of '$SESSION'"
    resumable=$(grep -c '^pane=.*|[^|]\{8,\}$' "$snap" 2>/dev/null || echo 0)
    panes=$(grep -c '^pane=' "$snap" 2>/dev/null || echo 0)
    echo "msesh: snapshot of '$SESSION' — $panes pane(s), $resumable with a conversation to resume"
    echo "msesh: $snap"
    [ "$resumable" = 0 ] && [ "$panes" != 0 ] &&
      echo "msesh: no conversations recorded yet — 'msesh hooks install' is what records them"
    exit 0 ;;
  kill)
    if session_exists "$SESSION"; then
      # Snapshotted before it dies, not after: this is the last moment the
      # conversation ids and the geometry exist to be read, and killing is how
      # a session normally ends. Failure here never blocks the kill — a
      # session you asked to go away has to go away.
      snapshot_write "$SESSION" >/dev/null 2>&1 || true
      "$TMUX_BIN" kill-session -t "=$SESSION"
      echo "msesh: killed '$SESSION'"
    else
      echo "msesh: no session '$SESSION' to kill"
    fi
    exit 0 ;;
  killall)
    # Identified by the @msesh stamp on the session, not by its name — you are
    # free to call a session whatever you like and 'kill --all' still finds it,
    # and a tmux session you set up yourself is never caught in the sweep.
    # #S carries no braces for a Windows-side shell to mangle on the way to
    # tmux.exe, and the stamp is then read one session at a time with no format
    # string at all.
    killed=0
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      # Plain name, no "=" prefix: show-options rejects the exact-match form
      # that has-session and kill-session accept.
      stamp=$("$TMUX_BIN" show-options -t "$s" -qv @msesh 2>/dev/null || true)
      [ "$stamp" = 1 ] || continue
      "$TMUX_BIN" kill-session -t "=$s" && echo "msesh: killed '$s'"
      killed=1
    done < <("$TMUX_BIN" list-sessions -F '#S' 2>/dev/null || true)
    [ "$killed" = 1 ] || echo "msesh: no msesh sessions running"
    exit 0 ;;
esac

# --- a layout as the whole build ---------------------------------------------
# 'msesh build quad' where 'quad' is a layout builds that session: its panes,
# its directory, its effort ladder, under its own name. This is the point of
# layouts — the alternative was 'msesh restore quad', which reads as recovery
# rather than as launching the thing you defined.
#
# Only as the sole spec. A layout is a session, so 'build quad +pwsh' or
# 'build 3 quad' are asking for something that has no meaning; saying so is
# better than picking one of the two possible guesses.
if [ "$ACTION" = build ] && [ "$ADD" = 0 ] && [ "${#SPECS[@]}" -gt 0 ]; then
  if [ "${#SPECS[@]}" = 1 ] && layout_exists "${SPECS[0]}"; then
    LAYOUT_NAME=${SPECS[0]}
    SPECS=()
    [ "$SESSION_SET" = 1 ] || SESSION=$LAYOUT_NAME
    # A layout of a session that is already up is an attach, same as any other
    # build of a live session — the panes are already there.
    if ! session_exists "$SESSION"; then
      layout_load "$LAYOUT_NAME" || die "cannot read layout '$LAYOUT_NAME'"
    fi
  fi
fi

# --- restore ----------------------------------------------------------------
# `restore` loads a manifest outright, falling back to a layout of the same
# name: what you asked for is "bring NAME up", and if the only description of
# NAME is the one you wrote yourself, that is the one to use. `build NAME`
# above is the other way round on purpose — it always uses the definition,
# because building is what you do when you want it as designed.
#
# Naming a session msesh knows about that is not currently running loads it
# too, when you gave no specs of your own: after a reboot, `msesh build -s
# work` should simply bring work back rather than ask you to re-describe it.
# Options typed on this invocation still win over either file.
if [ "$RESTORE" = 1 ]; then
  # A snapshot is the last fallback, and only because it carries the same keys:
  # a session that was killed and then forgotten still has its snapshots, and
  # refusing to bring one back when the description of it is sitting right
  # there would be a rule with nothing behind it.
  manifest_load "$SESSION" || layout_load "$SESSION" ||
    { snapfallback=$(snapshot_newest "$SESSION" 2>/dev/null || true)
      [ -n "$snapfallback" ] && conf_read "$snapfallback"; } ||
    die "no manifest or layout for '$SESSION' (msesh list shows what is known)"
elif [ "${#SPECS[@]}" -eq 0 ] && { ! session_exists "$SESSION" || [ "$FRESH" = 1 ]; }; then
  # An if rather than `manifest_load && echo`: that list's status is the whole
  # branch's status, so with `set -e` a session that had no manifest used to
  # end the script here instead of falling through to build a default pane.
  #
  # The FRESH arm is why 'rebuild' with no specs is not destructive. It used to
  # be gated on the session *not* existing, which is exactly the case rebuild is
  # never in: so a bare rebuild built the default one pane and then wrote that
  # over the manifest's spec list. A three-pane session came back as one and
  # restore could not recover it — the record was gone, not just the session.
  # Reading the manifest first is also what 'msesh help' has always promised.
  if manifest_load "$SESSION"; then
    [ "$FRESH" = 1 ] && echo "msesh: rebuilding '$SESSION' from its manifest" \
                     || echo "msesh: restoring '$SESSION' from its manifest"
  elif layout_load "$SESSION"; then
    echo "msesh: building '$SESSION' from its layout"
  elif [ "$ATTACH_ONLY" = 1 ]; then
    die "no session '$SESSION', and no manifest or layout to build it from (msesh list)"
  fi
fi

# Agent panes are lazy unless you said something. Asking for four panes should
# not start four agents: they are slow, they cost money, and half of them are
# usually there to be used later. Naming an effort with -e is taken as "yes, I
# mean it" — as is --eager. Shell panes are unaffected; --lazy only ever
# applied to agents.
if [ "$EAGER_SET" = 0 ] && [ -z "$EFFORTS_RAW" ]; then EAGER=0; fi

[ -d "$WORKDIR" ] || die "no such directory: $WORKDIR"
case $PANES_PER_WINDOW in ''|*[!0-9]*) die "--width needs a number, got '$PANES_PER_WINDOW'" ;; esac
case $NOTIFY_SILENCE in ''|*[!0-9]*) die "--notify needs seconds, got '$NOTIFY_SILENCE'" ;; esac

# --- resolve SPECs into a pane list ------------------------------------------
# Walk left to right holding at most one pending count. A preset name consumes
# the pending count; a second bare number flushes the first against the default
# preset; anything still pending at the end becomes default-preset panes.
PANE_CMD=()      # command each pane runs
PANE_LABEL=()    # what the pane border says
PANE_DIR=()      # where it starts; empty means the session's --dir

pending=

add_panes() {
  local name=$1 count=$2 cmd label
  case $name in
    '!'*) cmd=${name#!}; label=${cmd%% *} ;;
    *)    # Caught here rather than only where a build resolves a layout, so
          # that 'msesh add quad' and 'msesh build 3 quad' get the same answer
          # as each other instead of "unknown preset".
          if layout_exists "$name"; then
            die "'$name' is a layout — a whole session, so build it on its own: msesh build $name"
          fi
          if ! cmd=$(preset_get "$name"); then
            # A known agent that is not installed is a different problem from a
            # name nobody has heard of, and saying so saves a hunt.
            if agent_field "$name" levels >/dev/null 2>&1; then
              die "'$name' is a known agent but is not on PATH — install it, or point a preset at it"
            fi
            die "unknown preset '$name' (msesh preset list)"
          fi
          label=$name ;;
  esac
  local n=0
  while [ "$n" -lt "$count" ]; do
    PANE_CMD+=("$cmd"); PANE_LABEL+=("$label"); n=$((n + 1))
  done
}

for spec in ${SPECS[@]+"${SPECS[@]}"}; do
  case $spec in
    ''|*[!0-9]*) ;;                                  # not a bare number
    *) [ -n "$pending" ] && add_panes "$DEFAULT_PRESET" "$pending"
       pending=$spec; continue ;;
  esac

  name=${spec#+}
  count=1
  case $name in
    '!'*) : ;;                                       # literal command, never NAME:N
    *:*)  count=${name##*:}; name=${name%:*}
          case $count in ''|*[!0-9]*) die "bad count in '$spec'" ;; esac ;;
    *)    if [ -n "$pending" ]; then count=$pending; pending=; fi ;;
  esac
  add_panes "$name" "$count"
done
[ -n "$pending" ] && add_panes "$DEFAULT_PRESET" "$pending"
[ "${#PANE_CMD[@]}" -gt 0 ] || add_panes "$DEFAULT_PRESET" 1

# --- effort levels ----------------------------------------------------------
# Assigned in order across the panes that can take one, last value repeating.
# 'ladder' is spelled out in generic level names rather than resolved per agent
# so that one -e means one sequence however many different agents are in the
# session; whether a given agent actually has the level it lands on is checked
# below, per pane.
EFFORTS=()
if [ -n "$EFFORTS_RAW" ]; then
  [ "$EFFORTS_RAW" = ladder ] && EFFORTS_RAW=low,medium,high
  IFS=, read -r -a raw <<< "$EFFORTS_RAW"
  for e in "${raw[@]}"; do
    case $e in
      l|lo)          e=low ;;
      m|med)         e=medium ;;
      h|hi)          e=high ;;
      x|xh)          e=xhigh ;;
      '')            continue ;;
    esac
    EFFORTS+=("$e")
  done
fi

# A pane takes part in -e only if its agent has an effort flag at all. A shell
# pane, or an agent that has no such setting, is skipped rather than counted
# and then not injected — otherwise a session mixing claude with gemini would
# assign the second level to a pane that cannot use it and quietly shift every
# level after it by one.
if [ "${#EFFORTS[@]}" -gt 0 ]; then
  ci=0
  for i in "${!PANE_CMD[@]}"; do
    agent=$(agent_of_cmd "${PANE_CMD[$i]}") || continue
    flag=$(agent_field "$agent" effort)
    [ -n "$flag" ] || continue
    # Already spelled out by the preset itself — that is a deliberate choice
    # and outranks the command line. Matched on the whole flag minus its
    # trailing separator ('--effort', '-c model_reasoning_effort='), not on its
    # first word, or codex's '-c' would match any -c the command already had.
    flagtext=${flag%"${flag##*[![:space:]]}"}
    case ${PANE_CMD[$i]} in *"$flagtext"*) continue ;; esac

    idx=$ci
    [ "$idx" -ge "${#EFFORTS[@]}" ] && idx=$(( ${#EFFORTS[@]} - 1 ))
    want=${EFFORTS[$idx]}
    levels=$(agent_field "$agent" levels)
    case ",$levels," in
      *",$want,"*) ;;
      *) die "pane $((i + 1)) runs $agent, which has no '$want' effort — it takes ${levels//,/, }" ;;
    esac

    PANE_CMD[$i]="${PANE_CMD[$i]} $flag$want"
    PANE_LABEL[$i]="${PANE_LABEL[$i]}/$want"
    ci=$((ci + 1))
  done
fi

# --- resuming the conversation, not just the shape ----------------------------
# Without this, 'restore' brings back four panes that have forgotten everything
# they were doing. The ids come from the newest snapshot of this session and are
# matched to panes positionally, which is the only correspondence there is: a
# pane has no identity across a kill, only a place in the order.
#
# Per pane, and never fatal. Three resumable panes and one fresh is the normal
# outcome — a pane that was never started has no conversation, and a restore
# that refused because of that would be useless exactly when it is needed.
RESUMED=0 RESUME_SKIPPED=0
RESUME_IDS=(); RESUME_DIRS=(); RESUME_LAYOUTS=()
if [ "$RESUME" = 1 ] && [ "$RESTORE" != 1 ]; then
  die "--resume goes with restore: 'msesh restore $SESSION --resume'"
fi
if [ "$RESUME" = 1 ]; then
  snapfile=$(snapshot_newest "$SESSION" 2>/dev/null || true)
  if [ -z "$snapfile" ]; then
    echo "msesh: no snapshot of '$SESSION' — restoring it fresh" >&2
    echo "msesh: snapshots are taken on 'msesh kill' and by 'msesh snapshot'" >&2
  else
    while IFS= read -r line || [ -n "$line" ]; do
      case ${line%%$'\r'} in
        pane=*) line=${line#pane=}
                # window|label|agent|cwd|id — the id is the last field, and the
                # cwd the one before it.
                RESUME_IDS+=("${line##*|}")
                line=${line%|*}
                RESUME_DIRS+=("${line##*|}") ;;
        window=*) line=${line#window=}
                # index|name|layout — the layout string contains no '|'
                RESUME_LAYOUTS+=("${line##*|}") ;;
      esac
    done < "$snapfile"

    for i in "${!PANE_CMD[@]}"; do
      # A recorded directory is worth restoring even when the conversation is
      # not: a pane that comes back in the wrong repository is wrong whether or
      # not it remembers anything.
      if [ "$i" -lt "${#RESUME_DIRS[@]}" ] && [ -d "${RESUME_DIRS[$i]}" ]; then
        PANE_DIR[$i]=${RESUME_DIRS[$i]}
      fi
      [ "$i" -lt "${#RESUME_IDS[@]}" ] || { RESUME_SKIPPED=$((RESUME_SKIPPED + 1)); continue; }
      rid=${RESUME_IDS[$i]}
      [ -n "$rid" ] || { RESUME_SKIPPED=$((RESUME_SKIPPED + 1)); continue; }
      agent=$(agent_of_cmd "${PANE_CMD[$i]}") || { RESUME_SKIPPED=$((RESUME_SKIPPED + 1)); continue; }
      rflag=$(agent_field "$agent" resume)
      # An agent with no way to be resumed is not an error; it just starts
      # fresh, the same as a pane whose conversation was never recorded.
      [ -n "$rflag" ] || { RESUME_SKIPPED=$((RESUME_SKIPPED + 1)); continue; }
      PANE_CMD[$i]="${PANE_CMD[$i]} $rflag$rid"
      PANE_LABEL[$i]="${PANE_LABEL[$i]}~"
      RESUMED=$((RESUMED + 1))
    done
  fi
fi

# Two different questions, kept apart on purpose. HAS_AGENT is "is anything in
# here slow to start", which is what --lazy is about; HAS_CLAUDE is only ever
# used for the workspace-trust pre-seed, which really is a Claude Code file
# format and has no business being asked about any other agent.
HAS_AGENT=0
HAS_CLAUDE=0
for c in "${PANE_CMD[@]}"; do
  agent_of_cmd "$c" >/dev/null && HAS_AGENT=1
  is_claude_cmd "$c" && HAS_CLAUDE=1
done

# --- window names -------------------------------------------------------------
# --windows repo,logs names the windows in order. Split once here rather than
# in the build loop so a dry run and a real build cannot disagree about it.
# 'msesh add' starts partway through a session's windows, so the nth window of
# this invocation is not the nth of the session; names apply to what this
# command creates, which is the only thing it can honestly name.
WINDOW_NAME_LIST=()
if [ -n "$WINDOW_NAMES" ]; then
  IFS=, read -r -a wraw <<< "$WINDOW_NAMES"
  for w in ${wraw[@]+"${wraw[@]}"}; do
    # tmux takes almost anything as a window name, but a colon or a dot is how
    # every target it accepts is punctuated, so a name containing one becomes
    # unaddressable.
    case $w in
      *[:.]*) die "window names cannot contain ':' or '.' — got '$w'" ;;
      '')     WINDOW_NAME_LIST+=("") ;;
      *)      WINDOW_NAME_LIST+=("$w") ;;
    esac
  done
fi

window_name_for() {                     # window_name_for INDEX (0-based)
  local i=$1
  [ "$i" -lt "${#WINDOW_NAME_LIST[@]}" ] || return 0
  printf '%s' "${WINDOW_NAME_LIST[$i]}"
}

# --- dry run ------------------------------------------------------------------
# Everything above resolved what this build would be; everything below starts
# doing it. So this is where a dry run stops — after the specs, presets, agent
# table and effort assignment have had their say, which is the part worth
# checking, and before tmux, the trust pre-seed or the manifest are touched.
#
# The window split is worked out the same way the build loop does it rather
# than being reported from it, which is the one duplication here; keeping the
# two in step matters more than saving four lines, so they sit next to each
# other in the file.
if [ "$DRY_RUN" = 1 ]; then
  echo "msesh: would build '$SESSION' — ${#PANE_CMD[@]} pane(s) in $WORKDIR"
  dper=$PANES_PER_WINDOW
  [ "$dper" = 0 ] && dper=${#PANE_CMD[@]}
  dwin=0
  for i in "${!PANE_CMD[@]}"; do
    if [ $(( i % dper )) = 0 ]; then
      dwin=$((dwin + 1))
      dname=$(window_name_for "$((dwin - 1))")
      [ -n "$dname" ] || dname="m$dwin"
      printf '  window %s\n' "$dname"
    fi
    printf '    %-22s %s\n' "${PANE_LABEL[$i]}" "${PANE_CMD[$i]}"
  done
  # The settings that are not visible in the pane list but change what you get.
  printf '  %s window(s), %s pane(s) per window' "$dwin" \
    "$([ "$PANES_PER_WINDOW" = 0 ] && echo all || echo "$PANES_PER_WINDOW")"
  [ "$EAGER" = 0 ] && [ "$HAS_AGENT" = 1 ] && printf ', agent panes pre-typed only'
  if [ "$NOTIFY_SILENCE" = 0 ]; then printf ', no toast'
  else printf ', toast after %ss of silence' "$NOTIFY_SILENCE"; fi
  [ "$EPHEMERAL" = 1 ] && printf ', dies with the tab'
  printf '\n'
  [ "$PRESEED_TRUST" = 1 ] && [ "$HAS_CLAUDE" = 1 ] &&
    echo "  would pre-seed workspace trust for $WORKDIR"
  [ "$RESUME" = 1 ] &&
    echo "  $RESUMED pane(s) would resume a conversation, $RESUME_SKIPPED would start fresh"
  echo "msesh: nothing was built (--dry-run)"
  exit 0
fi

# --- workspace trust ---------------------------------------------------------
# Claude Code specifically, and gated on HAS_CLAUDE for that reason: this reads
# and writes ~/.claude.json, which is that one tool's file. Another agent's
# equivalent, if it ever needs one, belongs in its own function beside this —
# not folded into it behind a generic name.
#
# Every claude pane otherwise stops on "do you trust the files in this folder?",
# so record the answer up front. claude walks the tree upwards, so an
# already-trusted ancestor means there is nothing to write.
# Beside ~/.claude by default, inside the directory when CLAUDE_CONFIG_DIR
# relocates it — see the note where CLAUDE_SETTINGS is set for why that
# asymmetry is real and not a typo.
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  CLAUDE_JSON=${CLAUDE_JSON:-$CLAUDE_CONFIG_DIR/.claude.json}
else
  CLAUDE_JSON=${CLAUDE_JSON:-$HOME/.claude.json}
fi

preseed_trust() {
  local py native_dir
  py=$(command -v python3 || command -v python || true)
  if [ -z "$py" ]; then
    echo "msesh: no python found — skipping trust pre-seed" >&2
    return 0
  fi
  # Claude Code keys its project entries by the platform's native path, which
  # on Windows is not the same string as the one this shell is holding.
  native_dir=$(plat_native_path "$WORKDIR")
  "$py" - "$CLAUDE_JSON" "$native_dir" <<'PY' || echo "msesh: trust pre-seed failed (panes may prompt)" >&2
import json, os, posixpath, sys

cfg_path, target = sys.argv[1], sys.argv[2].rstrip('/')
try:
    with open(cfg_path, encoding='utf-8') as fh:
        cfg = json.load(fh)
except FileNotFoundError:
    cfg = {}
projects = cfg.setdefault('projects', {})

d = target
while True:
    if projects.get(d, {}).get('hasTrustDialogAccepted') is True:
        sys.exit(0)                       # covered by this dir or an ancestor
    parent = posixpath.dirname(d)
    if not parent or parent == d:
        break
    d = parent

entry = projects.setdefault(target, {})
entry['hasTrustDialogAccepted'] = True
entry.setdefault('allowedTools', [])

tmp = cfg_path + '.msesh.tmp'
with open(tmp, 'w', encoding='utf-8') as fh:
    json.dump(cfg, fh, indent=2)
os.replace(tmp, cfg_path)
print('msesh: trusted %s' % target)
PY
}

# --- build ------------------------------------------------------------------
if [ "$FRESH" = 1 ] && session_exists "$SESSION"; then
  "$TMUX_BIN" kill-session -t "=$SESSION"
fi

EXISTED=0
session_exists "$SESSION" && EXISTED=1

if [ "$EXISTED" = 1 ] && [ "$ADD" = 0 ]; then
  # 'attach' asked for exactly this, so it gets no advice; 'build' found a
  # session where it meant to make one, so it gets told what its options are.
  if [ "$ATTACH_ONLY" = 1 ]; then
    echo "msesh: attaching to '$SESSION'"
  else
    echo "msesh: '$SESSION' is already up — attaching ('msesh add' for more panes, 'msesh rebuild' to start over)"
  fi
else
  [ "$PRESEED_TRUST" = 1 ] && [ "$HAS_CLAUDE" = 1 ] && preseed_trust

  # Keep the pane alive after its command exits, so a stray /exit or a crash
  # leaves you a shell in place instead of collapsing the layout.
  #
  # The @done stamp in the middle is what 'msesh status' reads. It has to be
  # set by the pane itself: tmux reports pane_current_command as the process
  # that owns the terminal's foreground group, which for 'CMD; exec $SHELL'
  # is the wrapper shell whether CMD is running or not — so asking tmux from
  # outside cannot tell a working pane from a finished one. Setting an option
  # on the way past can. -p with no target means "this pane", which the pane
  # knows from $TMUX_PANE.
  pane_cmd() {
    printf '%s; tmux set-option -p @done 1 2>/dev/null; exec "%s" -i' "$1" "$PANE_SHELL"
  }

  # Lazy panes get a bare shell and the command typed at the prompt, unrun.
  # send-keys lands in the pty's input buffer even before the shell draws its
  # first prompt, so there is no race to wait out here.
  lazy_shell() { printf 'exec "%s" -i' "$PANE_SHELL"; }

  WINDOWS=()
  per=$PANES_PER_WINDOW
  [ "$per" = 0 ] && per=${#PANE_CMD[@]}

  # 'msesh add' into a live session: keep going after its existing windows.
  winno=1
  if [ "$EXISTED" = 1 ]; then
    winno=$(( $("$TMUX_BIN" list-windows -t "=$SESSION" 2>/dev/null | wc -l) + 1 ))
  fi

  for i in "${!PANE_CMD[@]}"; do
    cmd=${PANE_CMD[$i]}
    label=${PANE_LABEL[$i]}
    # Per-pane, falling back to the session's directory. Only a restore that
    # read a snapshot ever sets this; every other build has one directory.
    pdir=${PANE_DIR[$i]:-$WORKDIR}

    lazy=0
    [ "$EAGER" = 0 ] && agent_of_cmd "$cmd" >/dev/null && lazy=1
    [ "$lazy" = 1 ] && launch=$(lazy_shell) || launch=$(pane_cmd "$cmd")

    slot=$(( i % per ))
    if [ "$slot" = 0 ]; then
      # A window called 'tests' says more than 'm2' everywhere a window name
      # appears — the status bar, the tab title when it is waiting, and the
      # toast that tells you which key to press. Names run out silently and
      # fall back to the counter, so naming the first two of five is fine.
      wname=$(window_name_for "${#WINDOWS[@]}")
      [ -n "$wname" ] || wname="m$winno"
      WINDOWS+=("$wname")
      winno=$((winno + 1))
      if [ "$EXISTED" = 1 ] || [ "${#WINDOWS[@]}" -gt 1 ]; then
        "$TMUX_BIN" new-window -d -t "=$SESSION" -n "$wname" -c "$pdir" "$launch"
        # -d leaves the old window current; select it so the splits below and
        # the "active pane" targeting land in the right place.
        "$TMUX_BIN" select-window -t "$SESSION:$wname"
      else
        "$TMUX_BIN" new-session -d -s "$SESSION" -n "$wname" -c "$pdir" "$launch"
      fi
      EXISTED=1                     # from here on the session is definitely up
    else
      # Not ${WINDOWS[-1]}: negative subscripts need bash 4.2, macOS ships 3.2.
      wname=${WINDOWS[$(( ${#WINDOWS[@]} - 1 ))]}
      "$TMUX_BIN" split-window -t "$SESSION:$wname" -c "$pdir" "$launch"
    fi

    # The pane just created is the active one in its window, so target the
    # window and let tmux resolve it. Pane indexes and #{} formats both get
    # unreliable crossing into tmux.exe from a Windows-side shell; this avoids
    # needing either.
    WIN="$SESSION:$wname"
    "$TMUX_BIN" set-option -p -t "$WIN" @label "$label"
    # Recorded now because it cannot be worked out later: once a pane is
    # running, tmux can tell you the wrapper shell but not what msesh put in
    # it, and 'msesh send' has to know which panes hold an agent.
    if agent=$(agent_of_cmd "$cmd"); then
      "$TMUX_BIN" set-option -p -t "$WIN" @agent "$agent"
    fi
    if [ "$lazy" = 1 ]; then
      "$TMUX_BIN" send-keys -l -t "$WIN" -- "$cmd"
    fi
    "$TMUX_BIN" select-layout -t "$WIN" tiled >/dev/null
  done

  # Geometry last, and only when a snapshot recorded some. Tiling is the right
  # default for a session being built, but a session being *restored* was
  # last seen at whatever sizes its owner dragged it to, and coming back evenly
  # tiled loses that. Applied per window, positionally, and ignored when it
  # does not take — a layout string from a differently sized terminal is a
  # cosmetic loss, not a reason to fail a restore.
  if [ "$RESUME" = 1 ] && [ "${#RESUME_LAYOUTS[@]}" -gt 0 ]; then
    for wi in "${!WINDOWS[@]}"; do
      [ "$wi" -lt "${#RESUME_LAYOUTS[@]}" ] || break
      lay=${RESUME_LAYOUTS[$wi]}
      [ -n "$lay" ] || continue
      "$TMUX_BIN" select-layout -t "$SESSION:${WINDOWS[$wi]}" "$lay" >/dev/null 2>&1 || true
    done
  fi

  # Pane indexes depend on pane-base-index, so read it rather than assume 0. It
  # is a window option, so -w is required. Read it here, not before the build:
  # with no tmux server up yet there is nothing to ask, and the fallback would
  # leave us selecting a pane that does not exist.
  PBASE=$("$TMUX_BIN" show-options -gwv pane-base-index 2>/dev/null || echo 0)
  case $PBASE in ''|*[!0-9]*) PBASE=0 ;; esac

  # Whether the alert gets marked on screen as well as toasted. Read once here
  # because both the per-window loop below and the session-wide block after it
  # need it, and they are far enough apart to drift.
  HIGHLIGHT=${MSESH_HIGHLIGHT:-1}

  for wname in "${WINDOWS[@]}"; do
    WIN="$SESSION:$wname"
    "$TMUX_BIN" set-window-option -t "$WIN" pane-border-status top >/dev/null
    # Two cues, deliberately at different scopes, because they answer different
    # questions. The window's borders go red when anything in it is waiting —
    # that is what catches your eye from another window. The WAITING tag is
    # per pane: this format is rendered once per pane, and @turn is a *pane*
    # option, so only the pane that actually finished a turn is marked.
    #
    # It used to switch on the window's @alert here, which meant every pane in
    # a four-pane window claimed to be waiting and you had to guess which one.
    # The silence timer still only knows about windows, so its alerts colour
    # the borders and leave the tag off — nothing claims to be the pane when
    # nothing knows which pane it was.
    #
    # The comma inside the style has to be escaped or the format parser reads
    # it as the end of the true branch.
    # Two states, and the difference matters: INPUT means the agent is blocked
    # on you right now, WAITING means it finished and the next move is yours.
    # Only the first is urgent, so only the first is red.
    # The label is stated white rather than left to inherit. Inheriting means
    # it takes the border's colour, so when a window dims or reddens the names
    # go with it — exactly when you most need to read which pane is which. A
    # fixed white keeps the names legible and lets the colour carry only the
    # one thing it is for: state.
    "$TMUX_BIN" set-window-option -t "$WIN" pane-border-format \
      ' #{?#{==:#{@turn},input},#[fg=colour196#,bold]<< INPUT NEEDED >>#[default] ,#{?#{==:#{@turn},waiting},#[fg=colour214#,bold]<< done >>#[default] ,}}#[fg=colour255]#{pane_index}: #{@label}#[default] ' >/dev/null
    # The silence timer answers "has anything printed lately", which is not the
    # question. It exists because there was no way to know a turn had ended —
    # but where the turn-end hook is installed and every pane in this window is
    # an agent, there is, and leaving the timer armed only manufactures false
    # positives: a window nobody has typed in for twenty seconds is idle, not
    # waiting on you, and marking it red teaches you to ignore red.
    #
    # A window holding a shell keeps the timer, because for that pane silence
    # really is the only signal there is. An explicit --notify always wins:
    # someone who asked for the timer gets it.
    # An empty @agent is a pane msesh did not put an agent in — a shell, or a
    # literal command. One of those in the window is enough to keep the timer.
    # Armed for every window again, because silence no longer claims to be a
    # request: it dims the window and says nothing else. Disarming it was the
    # right answer while silence still reddened and toasted — a window nobody
    # has typed in for twenty seconds is idle, not waiting on you — but the fix
    # belonged in what the alert *does*, not in whether idleness is noticed.
    # Seeing at a glance which panes have gone quiet is useful; being
    # interrupted about it was not.
    NOTIFY_THIS=$NOTIFY_SILENCE
    # A bell is a real event a program chose to raise, not an inference from
    # nothing happening, so it is monitored whatever the silence timer is doing.
    # Turning it off with the timer was an accident of them sharing a block.
    "$TMUX_BIN" set-window-option -t "$WIN" monitor-bell on >/dev/null
    # Explicitly off: activity monitoring restarts the silence countdown on
    # every byte a pane prints, so a window that is merely chatty never goes
    # quiet enough to alert. The two monitors do not compose.
    "$TMUX_BIN" set-window-option -t "$WIN" monitor-activity off >/dev/null

    if [ "$NOTIFY_THIS" != 0 ]; then
      "$TMUX_BIN" set-window-option -t "$WIN" monitor-silence "$NOTIFY_THIS" >/dev/null
      # A window that was built seconds ago is quiet because nothing has run in
      # it yet, not because it wants you. Pre-stamp it as already-notified so
      # that first alert is swallowed; the notifier re-arms the window once you
      # have looked at it, and every alert after that is real.
      "$TMUX_BIN" set-window-option -t "$WIN" @msesh_notified 1 >/dev/null

      # The status bar's mark for a waiting window. It has to be set here, on
      # each window, and not once on the session: window-status-format is a
      # *window* option, so `set-option -t SESSION` resolves the target to that
      # session's current window and quietly styles only that one. Every window
      # built after it — the whole point, since a window you are looking at
      # never alerts — was left with the default format and never went red.
      #
      # tmux's own '~' silence flag comes from #F, which a status format that
      # spells out '#I #W' — as this machine's does — drops on the floor, so
      # the flag is put back explicitly. The comma inside the style is escaped
      # or the format parser reads it as the end of the true branch.
      if [ "$HIGHLIGHT" != 0 ]; then
        # Nested #{?} rather than #{||:}: both evaluate the same, and this one
        # cannot be misread when someone comes back to edit it.
        "$TMUX_BIN" set-window-option -t "$WIN" window-status-format \
          '#{?window_silence_flag,#[fg=colour196#,bold] #I #W !#[default],#{?window_bell_flag,#[fg=colour196#,bold] #I #W !#[default], #I #W }}' >/dev/null
      fi
    fi
    "$TMUX_BIN" select-pane -t "$WIN.$PBASE"
  done
  "$TMUX_BIN" select-window -t "$SESSION:${WINDOWS[0]}"

  # --- desktop notifications ------------------------------------------------
  # A pane that stops producing output has, in practice, finished its turn and
  # is waiting on you — true for claude and for a build or a REPL alike. tmux
  # raises the alert only for windows that are not currently on screen, so the
  # pane you are already watching never toasts at you.
  #
  # The hook body carries no #{} formats on purpose: this string is built by a
  # possibly-Windows-side shell, and the helper can ask tmux which windows are
  # flagged once it is running MSYS2-side, where formats are safe.
  "$TMUX_BIN" set-option -t "$SESSION" @msesh 1 >/dev/null

  # Anything a pane launches should be able to say which pane it came from.
  # What that takes is a platform question; here it is only a list of pairs.
  while read -r _k _v; do
    [ -n "$_k" ] && "$TMUX_BIN" set-environment -t "$SESSION" "$_k" "$_v" 2>/dev/null
  done < <(plat_pane_env_pairs)

  # Going to a pane clears its mark. Until now the only things that cleared one
  # were answering the agent and switching tmux windows — and a session that is
  # a single window in a Terminal tab does neither, so a mark you had read
  # stayed on screen until something else happened to clear it, which read as
  # "it goes away on a timer" rather than "it goes away when I deal with it".
  #
  # after-select-pane is the one interaction tmux does report: selecting a pane
  # with the mouse or the keyboard. Focus is not available — no client-focus-in
  # on a tab switch, no pane-focus-in on selection, both tested — so this is
  # the whole of what "you looked at it" can mean here.
  "$TMUX_BIN" set-hook -t "$SESSION" after-select-pane \
    "run-shell -b \"'${MSESH_NOTIFIER:-$SELF_DIR/msesh-notify}' --seen '#{pane_id}'\"" >/dev/null 2>&1 || true
  if [ "$NOTIFY_SILENCE" != 0 ]; then
    NOTIFIER=${MSESH_NOTIFIER:-$SELF_DIR/msesh-notify}
    "$TMUX_BIN" set-option -t "$SESSION" visual-silence off >/dev/null
    "$TMUX_BIN" set-option -t "$SESSION" visual-bell off >/dev/null
    "$TMUX_BIN" set-option -t "$SESSION" bell-action any >/dev/null
    "$TMUX_BIN" set-option -t "$SESSION" silence-action any >/dev/null
    for ev in alert-silence alert-bell alert-activity; do
      "$TMUX_BIN" set-hook -t "$SESSION" "$ev" "run-shell -b '$NOTIFIER'" >/dev/null
    done
    # tmux has hooks for an alert being raised and none for one being cleared,
    # so without this the notifier would not run again until the next alert
    # anywhere in the session — and the red border would still be sitting on a
    # window you had already dealt with. Switching windows is what clears an
    # alert, so it is also what has to take the highlight off.
    "$TMUX_BIN" set-hook -t "$SESSION" after-select-window \
      "run-shell -b '$NOTIFIER'" >/dev/null

    # --- say it on screen too -------------------------------------------
    # A toast tells you something is waiting and then disappears; it does not
    # survive being missed, and with several sessions in several tabs it does
    # not say where to go. These make the alert visible in the terminal for as
    # long as it lasts, at each level you might be looking at:
    #
    #   the tab      set-titles puts the alert in the Windows Terminal tab
    #                title, so an unfocused tab advertises itself
    #   the status   the alerting window is marked in the status bar — set per
    #                window in the loop above, because that option is a window
    #                one and setting it here would only ever reach one window
    #   the block    msesh-notify colours the window's borders, above
    #
    # These two are genuinely session options, so nothing outside msesh's own
    # sessions is restyled. Set MSESH_HIGHLIGHT=0 to leave all three alone.
    if [ "$HIGHLIGHT" != 0 ]; then
      "$TMUX_BIN" set-option -t "$SESSION" set-titles on >/dev/null
      # session_alerts spells the alert type into the list — silence is '2~',
      # not '2' — and the number on its own is the key you press, so the
      # suffixes come off before the title claims otherwise.
      "$TMUX_BIN" set-option -t "$SESSION" set-titles-string \
        '#{?session_alerts,(!) ,}msesh: #S#{?session_alerts, — window #{s/[~!]//:session_alerts} waiting,}' >/dev/null
    fi
  fi

  manifest_save

  n=${#PANE_CMD[@]}
  w=${#WINDOWS[@]}
  echo "msesh: '$SESSION' — $n pane(s) across $w window(s)"
  [ "$EAGER" = 0 ] && [ "$HAS_AGENT" = 1 ] &&
    echo "msesh: --lazy, so agent panes are pre-typed, not started — press Enter in the ones you want"
fi

# --- lifetime ---------------------------------------------------------------
# Persistent by default: the session outlives the tab, so `msesh attach` returns
# to it instead of paying for a rebuild. --ephemeral opts out, and is armed by a
# hook rather than set outright because a session with no client yet would be
# torn down the instant it was created.
if [ "$EPHEMERAL" = 1 ]; then
  # NB: plain session name here, not "=$SESSION" — set-hook rejects that form.
  "$TMUX_BIN" set-hook -t "$SESSION" client-attached \
    "set-option -t $SESSION destroy-unattached on"
else
  "$TMUX_BIN" set-hook -u -t "$SESSION" client-attached 2>/dev/null || true
  "$TMUX_BIN" set-option -t "$SESSION" destroy-unattached off

  # Outliving the tab is the point, but outliving it forever is just litter:
  # close four tabs over a morning and the sessions are all still there,
  # holding agents nobody is talking to. So a closed session is reaped after
  # MSESH_REAP_AFTER seconds — long enough that closing a tab by accident, or
  # detaching to move it, costs nothing, short enough that it does not pile up.
  #
  # Armed on detach, checked again when it fires: re-attaching in the meantime
  # cancels it, because the check is "is anyone here now", not "was anyone here
  # when the timer started". Several timers can be in flight after several
  # detaches and they all agree.
  #
  # MSESH_REAP_AFTER=0 keeps sessions forever, which is the old behaviour.
  if [ "$REAP_AFTER" != 0 ]; then
    # Through msesh's own kill, not tmux's. Killing the session directly would
    # take the panes and leave nothing behind: 'msesh kill' is what writes the
    # snapshot — the window layout, each pane's directory, which conversation
    # was in which pane — and that snapshot is the whole reason reaping is
    # cheap rather than lossy. 'restore --resume' reads it and the session
    # comes back as it was; without it, all that survives is the manifest's
    # shape. The tmux kill stays as a fallback so a moved or uninstalled msesh
    # cannot leave sessions accumulating forever.
    # Snapshot first, then wait, then kill. The snapshot is taken the moment
    # the tab closes rather than half an hour later, because the half hour is
    # exactly when a machine gets rebooted: a session killed by a restart runs
    # no hooks at all, so anything not already on disk is gone. Writing it up
    # front costs ~1 KB and makes the reboot case as recoverable as a clean
    # kill. The kill takes another one, which is the one that records how the
    # session looked at the very end.
    "$TMUX_BIN" set-hook -t "$SESSION" client-detached \
      "run-shell -b \"'$SELF_DIR/msesh' snapshot '$SESSION' >/dev/null 2>&1; sleep $REAP_AFTER; tmux list-clients -t '$SESSION' 2>/dev/null | grep -q . || '$SELF_DIR/msesh' kill '$SESSION' >/dev/null 2>&1 || tmux kill-session -t '$SESSION'\""
  else
    "$TMUX_BIN" set-hook -u -t "$SESSION" client-detached 2>/dev/null || true
  fi
fi

[ "$OPEN_TAB" = 1 ] || { echo "msesh: '$SESSION' ready (not attached)"; exit 0; }

# Already inside tmux: switching the client beats nesting a second server.
if [ -n "${TMUX:-}" ]; then
  exec "$TMUX_BIN" switch-client -t "$SESSION"
fi

# --- open a terminal attached to it -----------------------------------------
# Which terminal, and how it is asked, is the platform layer's business. What
# is msesh's business is the command that terminal should run, and what to do
# when the machine has no terminal to open — which is a normal state, not a
# failure: a headless server, an ssh session, a stripped container.
ATTACH_CMD="tmux attach -t $SESSION || exec \"\$SHELL\" -l"

# A title is passed only when the alert mechanism is off. Windows Terminal, at
# least, treats an explicit title as an override and stops honouring the escape
# sequence tmux sets titles with — fine for a static label, useless once the
# title is carrying "which window is waiting on you".
TAB_TITLE=
if [ "${MSESH_HIGHLIGHT:-1}" = 0 ] || [ "$NOTIFY_SILENCE" = 0 ]; then
  TAB_TITLE="msesh: $SESSION"
fi

if ! plat_open_tab "$SESSION" "$WORKDIR" "$ATTACH_CMD" "$TAB_TITLE"; then
  echo "msesh: '$SESSION' is up, but no terminal on this machine could be opened"
  echo "msesh: attach with:  tmux attach -t $SESSION"
  echo "msesh: (set MSESH_TERMINAL, or use --no-tab to stop trying)"
fi
